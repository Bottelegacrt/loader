local function fullTheme(colors)
	local t = {}
	for k, v in pairs(UI.Themes.Purple) do t[k] = v end
	for k, v in pairs(colors) do
		if typeof(v) == "Color3" then t[k] = v end
	end
	t.DangerHover = t.Danger:Lerp(Color3.new(1, 1, 1), 0.18)
	return t
end

