local function attachElements(obj)
    obj.Values = obj.Values or {}
    UI.Registry[obj.ConfigKey] = UI.Registry[obj.ConfigKey] or {}
    obj.Setters = UI.Registry[obj.ConfigKey] -- сохраняемые сеттеры (общий реестр)
    obj.Controls = {}                        -- все сеттеры, включая NoSave
    obj.Order = 0

    local function store(name, value)
        obj.Values[name] = value
        UI.Config[obj.ConfigKey] = UI.Config[obj.ConfigKey] or {}
        UI.Config[obj.ConfigKey][name] = value
    end

    local function register(name, fn, noSave)
        obj.Controls[name] = fn
        if not noSave then obj.Setters[name] = fn end
    end

