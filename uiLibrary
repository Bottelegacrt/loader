	end)
	connect(Button.MouseLeave, function()
		if UI.CurrentTab ~= Tab then tween(Button, 0.14, { BackgroundTransparency = 1 }) end
	end)
	connect(Button.MouseButton1Click, function() UI:OpenTab(Tab, true) end)
