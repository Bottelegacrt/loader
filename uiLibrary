local function tint(color)
	return color:Lerp(Color3.new(1, 1, 1), 0.4)
end

local function formatValue(value)
	if typeof(value) == "EnumItem" then return value.Name end
	return tostring(value)
end

local function toHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function toRGBString(c)
	return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function parseHex(text)
	local hex = (tostring(text):gsub("[#%s]", ""))
	if #hex == 6 and hex:match("^%x+$") then
		return Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
	end
	return nil
end

local function normalizeItems(items)
	local result = {}
	for _, item in ipairs(items or {}) do
		if type(item) == "table" then
			local value = item.Value
			if value == nil then value = item[1] end
			local name = item.Name
			if name == nil then name = value end
			table.insert(result, { Name = tostring(name), Value = value, Key = tostring(value), Color = item.Color })
		else
			table.insert(result, { Name = tostring(item), Value = item, Key = tostring(item) })
		end
	end
	return result
end

local function containsValue(values, key)
	if type(values) ~= "table" then return false end
	if values[key] == true then return true end
	for _, v in ipairs(values) do
		if tostring(v) == key then return true end
	end
	return false
end

local function nameOf(items, value)
	local key = tostring(value)
	for _, item in ipairs(items) do
		if item.Key == key then return item.Name end
	end
	return formatValue(value)
end

local function valueOf(items, value)
	local key = tostring(value)
	for _, item in ipairs(items) do
		if item.Key == key then return item.Value end
	end
	return value
end

local function textWidth(text, size, font)
	local ok, result = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(1000, 100))
	end)
	return ok and result.X or (#text * size * 0.56)
end

local function hoverStyle(button, base, hover, textBase, textHover)
	themeObject(button, "BackgroundColor3", base)
	themeObject(button, "TextColor3", textBase)
	connect(button.MouseEnter, function()
		tween(button, 0.14, { BackgroundColor3 = UI.Theme[hover], TextColor3 = UI.Theme[textHover or textBase] })
	end)
	connect(button.MouseLeave, function()
		tween(button, 0.14, { BackgroundColor3 = UI.Theme[base], TextColor3 = UI.Theme[textBase] })
	end)
end

local function ripple(button, mx, my)
	if not button.Parent then return end
	local scale = RootScale and RootScale.Scale or 1
	local ap, asz = button.AbsolutePosition, button.AbsoluteSize
	local lx, ly = (mx - ap.X) / scale, (my - ap.Y) / scale
	local size = math.max(asz.X, asz.Y) / scale * 2.4
	button.ClipsDescendants = true
	local r = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(lx, ly), Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.82, BorderSizePixel = 0,
	}, button)
	corner(r, 999)
	tween(r, 0.55, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	Debris:AddItem(r, 0.6)
end

local function withRipple(button)
	connect(button.MouseButton1Down, function(x, y) ripple(button, x, y) end)
end

local function createGlyph(parent, icon, fallback, size, position, radius, themed)
	local Box = create("Frame", { Size = UDim2.fromOffset(size, size), Position = position, BorderSizePixel = 0 }, parent)
	corner(Box, radius or 9)
	if themed ~= false then themeObject(Box, "BackgroundColor3", "Element") end

	local Glyph
	if icon and icon ~= "" then
		if type(icon) == "number" then icon = "rbxassetid://" .. icon end
		Glyph = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.56, 0.56), BackgroundTransparency = 1, Image = icon,
		}, Box)
		if themed ~= false then themeObject(Glyph, "ImageColor3", "Accent") end
	else
		Glyph = create("TextLabel", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Text = string.upper(string.sub(tostring(fallback or "?"), 1, 1)),
			Font = Enum.Font.GothamBold, TextSize = math.floor(size * 0.46),
		}, Box)
		if themed ~= false then themeObject(Glyph, "TextColor3", "Accent") end
	end
	return Box, Glyph
end

local function createGear(parent, size, position)
	local Holder = create("Frame", {
		Size = UDim2.fromOffset(size, size), Position = position, AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1, BorderSizePixel = 0,
	}, parent)
	local hole = size * 0.4
	local Ring = create("Frame", {
		Size = UDim2.fromOffset(hole, hole), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1, BorderSizePixel = 0,
	}, Holder)
	create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, Ring)
	local RingStroke = create("UIStroke", {
		Thickness = math.max(2, math.floor(size * 0.16 + 0.5)), ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, Ring)
	local teeth = {}
	local radius = size * 0.37
	for i = 0, 7 do
		local a = math.rad(i * 45)
		local T = create("Frame", {
			Size = UDim2.fromOffset(math.max(2, size * 0.2), size * 0.26), AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.sin(a) * radius, 0.5, -math.cos(a) * radius),
			Rotation = i * 45, BorderSizePixel = 0,
		}, Holder)
		create("UICorner", { CornerRadius = UDim.new(0, 1) }, T)
		table.insert(teeth, T)
	end
	local gear = { Holder = Holder }
	function gear:SetColor(color, instant)
		applyProps(RingStroke, { Color = color }, instant)
		for _, t in ipairs(teeth) do applyProps(t, { BackgroundColor3 = color }, instant) end
	end
	return gear
end

local function createStateChip(parent, position, width, height, state, onClick)
	local Button = create("TextButton", {
		Size = UDim2.fromOffset(width, height), Position = position, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
	}, parent)
	corner(Button, height / 2)
	local Outline = create("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Button)
	local Label = create("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Font = Enum.Font.GothamBold,
		TextSize = height < 26 and 10 or 11,
	}, Button)

	local chip = { Button = Button, State = state == true }
	local hovered = false
	local function paint(instant)
		local col = chip.State and UI.Theme.Success or UI.Theme.Danger
		Label.Text = chip.State and "Enabled" or "Disabled"
		applyProps(Button, { BackgroundColor3 = col, BackgroundTransparency = hovered and 0.62 or 0.8 }, instant)
		applyProps(Outline, { Color = col }, instant)
		applyProps(Label, { TextColor3 = tint(col) }, instant)
	end
	function chip:Set(value, instant)
		chip.State = value == true
		paint(instant)
	end
	paint(true)
	addThemeRefresher(function() paint(true) end)
	connect(Button.MouseEnter, function() hovered = true paint(false) end)
	connect(Button.MouseLeave, function() hovered = false paint(false) end)
	connect(Button.MouseButton1Click, function() onClick(not chip.State) end)
	return chip
end

