		p.o.Size = UDim2.fromOffset(math.max(1.5, r * 0.045), math.clamp(r / 160, 1, 2.4))
		p.o.BackgroundTransparency = math.clamp(0.9 - r / 220, 0.25, 0.9)
		p.o.Position = UDim2.fromOffset(FXW / 2 + math.cos(p.ang) * r, FXH / 2 + math.sin(p.ang) * r)
