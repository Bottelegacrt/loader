-- type: "info" | "success" | "warning" | "error"
function UI:Notify(title, message, duration, kind)
    if UI.NotificationsEnabled == false then return end
    if type(title) == "table" then
        local o = title
        title, message, duration, kind = o.Title, o.Message or o.Text, o.Duration, o.Type
    end
    if type(duration) == "string" then kind, duration = duration, nil end
    table.insert(notifQueue, {
        Title = tostring(title or ""), Message = tostring(message or ""),
        Duration = tonumber(duration) or 3.5, Kind = string.lower(tostring(kind or "info")),
    })
    UI.ProcessNotifQueue()
end

