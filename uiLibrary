----------------------------------------------------------------------
-- КОНФИГИ (файлы через writefile/readfile, в Studio работает в памяти)
----------------------------------------------------------------------
local HasFS = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
    and type(makefolder) == "function" and type(isfolder) == "function" and type(listfiles) == "function"
local ROOT_DIR, CONFIG_DIR = "Loyalty", "Loyalty/configs"
local Memory, MemoryAutoload = {}, nil

local function safeName(name)
    local n = tostring(name or ""):gsub("[^%w%-_ ]", "")
    return (n:match("^%s*(.-)%s*$"))
end

local function ensureDirs()
    if not HasFS then return end
    pcall(function()
        if not isfolder(ROOT_DIR) then makefolder(ROOT_DIR) end
        if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
    end)
end

local function encodeValue(v)
    local t = typeof(v)
    if t == "EnumItem" then
        return { __t = "Enum", Type = tostring(v.EnumType), Name = v.Name }
    elseif t == "Color3" then
        return { __t = "Color3", R = v.R, G = v.G, B = v.B }
    elseif t == "table" then
        local r = {}
        for i, x in ipairs(v) do r[i] = encodeValue(x) end
        return r
    elseif t == "number" or t == "string" or t == "boolean" then
        return v
    end
    return nil
end

local function decodeValue(v)
    if type(v) == "table" then
        if v.__t == "Enum" then
            local ok, r = pcall(function() return Enum[v.Type][v.Name] end)
            return ok and r or nil
        elseif v.__t == "Color3" then
            return Color3.new(v.R, v.G, v.B)
        end
        local r = {}
        for i, x in ipairs(v) do r[i] = decodeValue(x) end
        return r
    end
    return v
end

function UI:GetConfigData()
    local data = {}
    for key, setters in pairs(UI.Registry) do
        local values = UI.Config[key]
        if values then
            local entry = {}
            for name in pairs(setters) do
                local v = values[name]
                if v ~= nil then
                    local e = encodeValue(v)
                    if e ~= nil then entry[name] = e end
                end
            end
            data[key] = entry
        end
    end
    return { Version = 1, Data = data }
end

function UI:ApplyConfigData(payload)
    local data = type(payload) == "table" and (payload.Data or payload) or nil
    if type(data) ~= "table" then return false end
    for key, entry in pairs(data) do
        local setters = UI.Registry[key]
        if setters and type(entry) == "table" then
            for name, raw in pairs(entry) do
                local setter = setters[name]
                if setter then pcall(setter, decodeValue(raw), true) end
            end
        end
    end
    return true
end

function UI:ListConfigs()
    local list = {}
    if HasFS then
        ensureDirs()
        local ok, files = pcall(listfiles, CONFIG_DIR)
        if ok and type(files) == "table" then
            for _, path in ipairs(files) do
                local name = tostring(path):match("([^/\\]+)%.json$")
                if name then table.insert(list, name) end
            end
        end
    else
        for name in pairs(Memory) do table.insert(list, name) end
    end
    table.sort(list, function(a, b) return a:lower() < b:lower() end)
    return list
end

function UI:SaveConfig(name)
    name = safeName(name)
    if name == "" then return false, "Enter a config name" end
    local ok, json = pcall(function() return HttpService:JSONEncode(UI:GetConfigData()) end)
    if not ok then return false, "Failed to encode config" end
    if HasFS then
        ensureDirs()
        local wok, err = pcall(writefile, CONFIG_DIR .. "/" .. name .. ".json", json)
        if not wok then return false, tostring(err) end
    else
        Memory[name] = json
    end
    return true
end

function UI:LoadConfig(name)
    name = safeName(name)
    if name == "" then return false, "Select a config" end
    local json
    if HasFS then
        local path = CONFIG_DIR .. "/" .. name .. ".json"
        local ok, exists = pcall(isfile, path)
        if not ok or not exists then return false, "Config not found" end
        local rok, content = pcall(readfile, path)
        if not rok then return false, tostring(content) end
        json = content
    else
        json = Memory[name]
        if not json then return false, "Config not found" end
    end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok then return false, "Config file is corrupted" end
    UI:ApplyConfigData(decoded)
    return true
end

function UI:DeleteConfig(name)
    name = safeName(name)
    if name == "" then return false, "Select a config" end
    if HasFS then
        if type(delfile) ~= "function" then return false, "delfile is not supported by your executor" end
        local ok, err = pcall(delfile, CONFIG_DIR .. "/" .. name .. ".json")
        if not ok then return false, tostring(err) end
    else
        Memory[name] = nil
    end
    if UI:GetAutoload() == name then UI:SetAutoload(nil) end
    return true
end

function UI:GetAutoload()
    if HasFS then
        local ok, exists = pcall(isfile, ROOT_DIR .. "/autoload.txt")
        if ok and exists then
            local rok, content = pcall(readfile, ROOT_DIR .. "/autoload.txt")
            if rok then
                local n = safeName(content)
                return n ~= "" and n or nil
            end
        end
        return nil
    end
    return MemoryAutoload
end

function UI:SetAutoload(name)
    name = name and safeName(name) or nil
    if name == "" then name = nil end
    if HasFS then
        ensureDirs()
        pcall(writefile, ROOT_DIR .. "/autoload.txt", name or "")
    else
        MemoryAutoload = name
    end
end

-- вызовите в самом конце вашего скрипта, когда все фичи уже созданы
function UI:LoadAutoload()
    local name = UI:GetAutoload()
    if not name then return false end
    local ok, err = UI:LoadConfig(name)
    if ok then
        UI:Notify("Config loaded", "Autoload: " .. name, 3, "success")
    else
        UI:Notify("Autoload failed", tostring(err), 4, "error")
    end
    return ok
end

