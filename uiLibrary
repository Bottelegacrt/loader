function UI:Unload()
	if UI.AutoReady and UI.AutoDirty and UI.AutoConfig then
		pcall(function() UI:SaveConfig(AUTO_NAME) end)
	end
	UI.AutoReady = false
	UI:ClosePopup()
	for _, c in ipairs(UI.Connections) do pcall(function() c:Disconnect() end) end
	UI.Connections = {}
	if UI.ScreenGui then UI.ScreenGui:Destroy() end
	UI.Tabs, UI.TabList, UI.Features, UI.Config, UI.Registry = {}, {}, {}, {}, {}
	UI.ThemeObjects, UI.ThemeRefreshers = {}, {}
	UI.CurrentTab, UI.CurrentFeature = nil, nil
	if _G.__LoyaltyUI == UI then _G.__LoyaltyUI = nil end
end

