local function fxFrame(round)
	local f = create("Frame", { BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(4, 4) }, FX)
	if round then create("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f) end
	return f
end

local Effects = {}

Effects.Snow = {
	Count = function(d) return d end,
	Make = function(p) p.o = fxFrame(true) end,
	Spawn = function(p, first)
		p.s = rnd(2, 5)
		p.x = rnd(0, FXW)
		p.y = first and rnd(0, FXH) or rnd(-20, -4)
		p.vy = 18 + p.s * 9
		p.a = rnd(6, 26)
		p.f = rnd(0.5, 1.6)
		p.ph = rnd(0, 6.28)
		p.o.Size = UDim2.fromOffset(p.s, p.s)
		p.o.BackgroundTransparency = rnd(0.2, 0.7)
	end,
	Paint = function(p)
		p.o.BackgroundColor3 = Color3.new(1, 1, 1):Lerp(UI.Theme.Accent2, 0.15)
	end,
	Update = function(p, dt, t)
		p.y += p.vy * dt
		if p.y > FXH + 10 then
			p.x = rnd(0, FXW)
			p.y = -10
		end
		p.o.Position = UDim2.fromOffset(p.x + math.sin(t * p.f + p.ph) * p.a, p.y)
	end,
}

