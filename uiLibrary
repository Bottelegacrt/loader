local ActiveBucket = nil
local RootScale = nil

local function connect(signal, callback)
    local c = signal:Connect(callback)
    table.insert(UI.Connections, c)
    return c
end

local function popupConnect(signal, callback)
    local c = signal:Connect(callback)
    table.insert(UI.PopupConnections, c)
    return c
end

local function disconnectPopup()
    for _, c in ipairs(UI.PopupConnections) do pcall(function() c:Disconnect() end) end
    UI.PopupConnections = {}
end

local function tween(object, duration, properties, style, direction)
    if not object or not object.Parent then return end
    local t = TweenService:Create(object, TweenInfo.new(duration or 0.2, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out), properties)
    t:Play()
    return t
end

local function applyProps(object, props, instant)
    if instant then
        for k, v in pairs(props) do pcall(function() object[k] = v end) end
    else
        tween(object, 0.16, props)
    end
end

local function create(className, properties, parent)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        pcall(function() object[property] = value end)
    end
    if parent then object.Parent = parent end
    return object
end

local function corner(parent, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, parent)
end

-- итоговая прозрачность поверхности с учётом настройки Opacity
local function eff(t)
    return 1 - (1 - (t or 0)) * UI.Opacity
end

local function themeObject(object, property, key, base)
    table.insert(ActiveBucket or UI.ThemeObjects, { Object = object, Property = property, Key = key, Base = base })
    pcall(function() object[property] = UI.Theme[key] end)
    if base ~= nil then
        pcall(function() object.BackgroundTransparency = eff(base) end)
    end
    return object
end

-- "поверхность": фон, который подчиняется теме и настройке прозрачности
local function surface(object, key, base)
    return themeObject(object, "BackgroundColor3", key, base or 0)
end

local function stroke(parent, key, thickness, transparency)
    local s = create("UIStroke", {
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
    if key then themeObject(s, "Color", key) end
    return s
end

local function addThemeRefresher(callback)
    table.insert(UI.ThemeRefreshers, callback)
end

local function tint(color)
    return color:Lerp(Color3.new(1, 1, 1), 0.4)
end

local function formatValue(value)
    if typeof(value) == "EnumItem" then return value.Name end
    return tostring(value)
end

local function toHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function toRGBString(c)
    return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function parseHex(text)
    local hex = (tostring(text):gsub("[#%s]", ""))
    if #hex == 6 and hex:match("^%x+$") then
        return Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
    end
    return nil
end

local function normalizeItems(items)
    local result = {}
    for _, item in ipairs(items or {}) do
        if type(item) == "table" then
            local value = item.Value
            if value == nil then value = item[1] end
            local name = item.Name
            if name == nil then name = value end
            table.insert(result, { Name = tostring(name), Value = value, Key = tostring(value), Color = item.Color })
        else
            table.insert(result, { Name = tostring(item), Value = item, Key = tostring(item) })
        end
    end
    return result
end

local function containsValue(values, key)
    if type(values) ~= "table" then return false end
    if values[key] == true then return true end
    for _, v in ipairs(values) do
        if tostring(v) == key then return true end
    end
    return false
end

local function nameOf(items, value)
    local key = tostring(value)
    for _, item in ipairs(items) do
        if item.Key == key then return item.Name end
    end
    return formatValue(value)
end

local function valueOf(items, value)
    local key = tostring(value)
    for _, item in ipairs(items) do
        if item.Key == key then return item.Value end
    end
    return value
end

local function textWidth(text, size, font)
    local ok, result = pcall(function()
        return TextService:GetTextSize(text, size, font, Vector2.new(1000, 100))
    end)
    return ok and result.X or (#text * size * 0.56)
end

local function hoverStyle(button, base, hover, textBase, textHover)
    themeObject(button, "BackgroundColor3", base)
    themeObject(button, "TextColor3", textBase)
    connect(button.MouseEnter, function()
        tween(button, 0.14, { BackgroundColor3 = UI.Theme[hover], TextColor3 = UI.Theme[textHover or textBase] })
    end)
    connect(button.MouseLeave, function()
        tween(button, 0.14, { BackgroundColor3 = UI.Theme[base], TextColor3 = UI.Theme[textBase] })
    end)
end

-- ripple-эффект на кнопках
local function ripple(button, mx, my)
    if not button.Parent then return end
    local scale = RootScale and RootScale.Scale or 1
    local ap, asz = button.AbsolutePosition, button.AbsoluteSize
    local lx, ly = (mx - ap.X) / scale, (my - ap.Y) / scale
    local size = math.max(asz.X, asz.Y) / scale * 2.4
    button.ClipsDescendants = true
    local r = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(lx, ly), Size = UDim2.fromOffset(0, 0),
        BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.82, BorderSizePixel = 0,
    }, button)
    corner(r, 999)
    tween(r, 0.55, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
    Debris:AddItem(r, 0.6)
end

local function withRipple(button)
    connect(button.MouseButton1Down, function(x, y) ripple(button, x, y) end)
end

local function createGlyph(parent, icon, fallback, size, position, radius, themed)
    local Box = create("Frame", { Size = UDim2.fromOffset(size, size), Position = position, BorderSizePixel = 0 }, parent)
    corner(Box, radius or 9)
    if themed ~= false then themeObject(Box, "BackgroundColor3", "Element") end

    local Glyph
    if icon and icon ~= "" then
        if type(icon) == "number" then icon = "rbxassetid://" .. icon end
        Glyph = create("ImageLabel", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromScale(0.56, 0.56), BackgroundTransparency = 1, Image = icon,
        }, Box)
        if themed ~= false then themeObject(Glyph, "ImageColor3", "Accent") end
    else
        Glyph = create("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = string.upper(string.sub(tostring(fallback or "?"), 1, 1)),
            Font = Enum.Font.GothamBold, TextSize = math.floor(size * 0.46),
        }, Box)
        if themed ~= false then themeObject(Glyph, "TextColor3", "Accent") end
    end
    return Box, Glyph
end

local function createSwitch(parent, position, state, onClick)
    local Track = create("TextButton", {
        Size = UDim2.fromOffset(40, 22), Position = position, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
    }, parent)
    corner(Track, 11)
    stroke(Track, "Border", 1)
    local Knob = create("Frame", { Size = UDim2.fromOffset(16, 16), BorderSizePixel = 0 }, Track)
    corner(Knob, 8)

    local sw = { Track = Track, State = state }
    function sw:Set(value, instant)
        sw.State = value
        local style = Enum.EasingStyle.Quint
        if instant then
            Track.BackgroundColor3 = value and UI.Theme.Accent or UI.Theme.ElementHover
            Knob.Position = value and UDim2.new(0, 21, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
            Knob.BackgroundColor3 = value and UI.Theme.Text or UI.Theme.TextMuted
        else
            tween(Track, 0.22, { BackgroundColor3 = value and UI.Theme.Accent or UI.Theme.ElementHover }, style)
            tween(Knob, 0.26, {
                Position = value and UDim2.new(0, 21, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
                BackgroundColor3 = value and UI.Theme.Text or UI.Theme.TextMuted,
            }, Enum.EasingStyle.Back)
        end
    end
    sw:Set(state, true)
    addThemeRefresher(function() sw:Set(sw.State, true) end)
    connect(Track.MouseButton1Click, function() onClick(not sw.State) end)
    return sw
end

