local function connect(signal, callback)
	local c = signal:Connect(callback)
	table.insert(UI.Connections, c)
	return c
end

local function popupConnect(signal, callback)
	local c = signal:Connect(callback)
	table.insert(UI.PopupConnections, c)
	return c
end

local function disconnectPopup()
	for _, c in ipairs(UI.PopupConnections) do pcall(function() c:Disconnect() end) end
	UI.PopupConnections = {}
end

local function tween(object, duration, properties, style, direction)
	if not object or not object.Parent then return end
	local t = TweenService:Create(object, TweenInfo.new(duration or 0.2, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out), properties)
	t:Play()
	return t
end

local function applyProps(object, props, instant)
	if instant then
		for k, v in pairs(props) do pcall(function() object[k] = v end) end
	else
		tween(object, 0.16, props)
	end
end

local function create(className, properties, parent)
	local object = Instance.new(className)
	for property, value in pairs(properties or {}) do
		pcall(function() object[property] = value end)
	end
	if parent then object.Parent = parent end
	return object
end

local Corners = {}
local pruneAt = 900
local function pruneCorners()
	local alive = {}
	for _, c in ipairs(Corners) do
		if c.Object.Parent then table.insert(alive, c) end
	end
	Corners = alive
	pruneAt = #Corners + 500
end

local function corner(parent, radius)
	radius = radius or 8
	local scalable = radius < 100
	local c = create("UICorner", { CornerRadius = UDim.new(0, scalable and math.floor(radius * UI.Roundness + 0.5) or radius) }, parent)
	if scalable then
		table.insert(Corners, { Object = c, Base = radius })
		if #Corners > pruneAt then pruneCorners() end
	end
	return c
end

local function eff(t)
	return 1 - (1 - (t or 0)) * UI.Opacity
end

local function themeObject(object, property, key, base)
	table.insert(ActiveBucket or UI.ThemeObjects, { Object = object, Property = property, Key = key, Base = base })
	pcall(function() object[property] = UI.Theme[key] end)
	if base ~= nil then
		pcall(function() object.BackgroundTransparency = eff(base) end)
	end
	return object
end

local function surface(object, key, base)
	return themeObject(object, "BackgroundColor3", key, base or 0)
end

local function stroke(parent, key, thickness, transparency)
	local s = create("UIStroke", {
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
	if key then themeObject(s, "Color", key) end
	return s
end

