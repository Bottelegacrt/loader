	}, Button)
	themeObject(Badge, "TextColor3", "TextDark")

	Tab.Button, Tab.Badge = Button, Badge

	function Tab.ApplyVisual(instant)
		local active = UI.CurrentTab == Tab
		applyProps(Button, { BackgroundTransparency = active and 0 or 1 }, instant)
		applyProps(Label, { TextColor3 = active and UI.Theme.Text or UI.Theme.TextMuted }, instant)
		applyProps(Box, { BackgroundColor3 = active and UI.Theme.Accent or UI.Theme.Element }, instant)
		applyProps(Glyph, { [glyphProp] = active and UI.Theme.Text or UI.Theme.TextMuted }, instant)
		applyProps(Bar, {
