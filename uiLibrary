function UI:CreateFeature(Tab, options)
    if type(Tab) == "string" then Tab = UI.Tabs[Tab] end
    options = options or {}

    local Feature = {
        Name = tostring(options.Name or "Feature"),
        Description = tostring(options.Description or ""),
        Icon = options.Icon,
        Enabled = options.Enabled == true,
        Elements = {},
        Tab = Tab,
        Switches = {},
        Listeners = {},
    }
    Feature.SearchName = string.lower(Feature.Name .. " " .. Feature.Description)

    table.insert(Tab.Features, Feature)
    table.insert(UI.Features, Feature)
    UI.Config[Feature.Name] = { Enabled = Feature.Enabled }
    UI.Registry[Feature.Name] = UI.Registry[Feature.Name] or {}
    UI.Registry[Feature.Name].Enabled = function(v, invoke) Feature:SetEnabled(v, invoke) end
    Tab.Badge.Text = tostring(#Tab.Features)

    local group = getGroup(Tab)
    Feature.Group = group

    local Card = create("Frame", { BorderSizePixel = 0, LayoutOrder = #Tab.Features }, group.Frame)
    corner(Card, 10)
    surface(Card, "Panel", 0)
    local CardStroke = create("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Card)
    Feature.Card = Card

    local TopAccent = create("Frame", { Size = UDim2.new(1, -28, 0, 2), Position = UDim2.fromOffset(14, 0), BackgroundTransparency = 1, BorderSizePixel = 0 }, Card)
    corner(TopAccent, 1)
    themeObject(TopAccent, "BackgroundColor3", "Accent")

    createGlyph(Card, Feature.Icon, Feature.Name, 36, UDim2.fromOffset(14, 14), 10)

    local NameLabel = create("TextLabel", {
        Size = UDim2.new(1, -124, 0, 18), Position = UDim2.fromOffset(60, 14), BackgroundTransparency = 1,
        Text = Feature.Name, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, Card)
    themeObject(NameLabel, "TextColor3", "Text")

    local StatusLbl = create("TextLabel", {
        Size = UDim2.new(1, -124, 0, 14), Position = UDim2.fromOffset(60, 32), BackgroundTransparency = 1,
        Text = "", Font = Enum.Font.GothamBold, TextSize = 9, TextXAlignment = Enum.TextXAlignment.Left,
    }, Card)

    local DescLabel = create("TextLabel", {
        Size = UDim2.new(1, -28, 0, 30), Position = UDim2.fromOffset(14, 58), BackgroundTransparency = 1,
        Text = Feature.Description, Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd,
    }, Card)
    themeObject(DescLabel, "TextColor3", "TextMuted")

    local Divider = create("Frame", { Size = UDim2.new(1, -28, 0, 1), Position = UDim2.fromOffset(14, 92), BorderSizePixel = 0 }, Card)
    themeObject(Divider, "BackgroundColor3", "Border")

    local hovered = false
    local function paintCard(instant)
        local on = Feature.Enabled
        applyProps(CardStroke, {
            Color = on and UI.Theme.Accent or (hovered and UI.Theme.TextDark or UI.Theme.Border),
            Transparency = on and (hovered and 0.15 or 0.4) or 0,
        }, instant)
        applyProps(StatusLbl, { TextColor3 = on and UI.Theme.Success or UI.Theme.TextDark }, instant)
        applyProps(TopAccent, { BackgroundTransparency = on and 0 or 1 }, instant)
        StatusLbl.Text = on and "ENABLED" or "DISABLED"
    end
    paintCard(true)
    addThemeRefresher(function() paintCard(true) end)
    connect(Card.MouseEnter, function() hovered = true paintCard() end)
    connect(Card.MouseLeave, function() hovered = false paintCard() end)

    local tip = options.Tooltip or (#Feature.Description > 52 and Feature.Description or nil)
    if tip then UI:AddTooltip(Card, tip) end

    local CardSwitch = createSwitch(Card, UDim2.new(1, -54, 0, 17), Feature.Enabled, function(v) Feature:SetEnabled(v, true) end)
    table.insert(Feature.Switches, CardSwitch)

    -- нижняя полоса: Configure или подпись "No extra settings"
    local NoSettings = create("TextLabel", {
        Size = UDim2.new(1, -28, 0, 22), Position = UDim2.fromOffset(14, 96), BackgroundTransparency = 1,
        Text = "No extra settings", Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
    }, Card)
    themeObject(NoSettings, "TextColor3", "TextDark")

    local Strip = create("TextButton", {
        Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 96), BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, Visible = false,
    }, Card)
    corner(Strip, 6)
    themeObject(Strip, "BackgroundColor3", "ElementHover")
    local StripLabel = create("TextLabel", {
        Size = UDim2.new(1, -30, 1, 0), Position = UDim2.fromOffset(6, 0), BackgroundTransparency = 1, Text = "Configure",
        Font = Enum.Font.GothamMedium, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
    }, Strip)
    themeObject(StripLabel, "TextColor3", "TextMuted")
    local StripArrow = create("TextLabel", {
        Size = UDim2.fromOffset(16, 22), Position = UDim2.new(1, -22, 0, 0), BackgroundTransparency = 1, Text = "›",
        Font = Enum.Font.GothamBold, TextSize = 16,
    }, Strip)
    themeObject(StripArrow, "TextColor3", "TextMuted")
    connect(Strip.MouseEnter, function()
        tween(Strip, 0.15, { BackgroundTransparency = 0.5 })
        tween(StripLabel, 0.15, { TextColor3 = UI.Theme.Text })
        tween(StripArrow, 0.2, { TextColor3 = UI.Theme.Accent, Position = UDim2.new(1, -18, 0, 0) })
    end)
    connect(Strip.MouseLeave, function()
        tween(Strip, 0.15, { BackgroundTransparency = 1 })
        tween(StripLabel, 0.15, { TextColor3 = UI.Theme.TextMuted })
        tween(StripArrow, 0.2, { TextColor3 = UI.Theme.TextMuted, Position = UDim2.new(1, -22, 0, 0) })
    end)
    withRipple(Strip)
    connect(Strip.MouseButton1Click, function() UI:OpenFeatureSettings(Feature) end)

    function Feature:SetEnabled(state, invoke)
        state = state == true
        Feature.Enabled = state
        UI.Config[Feature.Name].Enabled = state
        for _, sw in ipairs(Feature.Switches) do sw:Set(state) end
        for _, fn in ipairs(Feature.Listeners) do fn(state) end
        paintCard(false)
        updateStatus()
        if invoke and Feature.EnableCallback then task.spawn(Feature.EnableCallback, state) end
        return Feature
    end

    function Feature:OnToggle(callback)
        Feature.EnableCallback = callback
        return Feature
    end

    function Feature:GetValue(name)
        return Feature.Elements[name]
    end

    function Feature:SetValue(name, value, invoke)
        local setter = UI.Registry[Feature.Name] and UI.Registry[Feature.Name][name]
        if setter then
            setter(value, invoke)
        else
            Feature.Elements[name] = value
            UI.Config[Feature.Name][name] = value
        end
        return Feature
    end

    function Feature:Configure(callback)
        if not Feature.SettingsPage then
            local root = createPageRoot()

            local Top = create("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1 }, root)
            local Back = create("TextButton", {
                Size = UDim2.fromOffset(88, 32), Position = UDim2.fromOffset(0, 4), BorderSizePixel = 0,
                Text = "‹   Back", Font = Enum.Font.GothamBold, TextSize = 12, AutoButtonColor = false,
            }, Top)
            corner(Back, 9)
            stroke(Back, "Border", 1)
            hoverStyle(Back, "Element", "Accent", "Text", "Text")
            withRipple(Back)
            connect(Back.MouseButton1Click, function() UI:OpenTab(Feature.Tab, true) end)

            local Sub = create("TextLabel", {
                Size = UDim2.new(1, -250, 1, 0), Position = UDim2.fromOffset(102, 0), BackgroundTransparency = 1,
                Text = Feature.Description ~= "" and Feature.Description or "Feature configuration",
                Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
            }, Top)
            themeObject(Sub, "TextColor3", "TextMuted")

            local StateLbl = create("TextLabel", {
                Size = UDim2.fromOffset(70, 40), Position = UDim2.new(1, -122, 0, 0), BackgroundTransparency = 1,
                Text = "", Font = Enum.Font.GothamBold, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right,
            }, Top)
            local function paintState(on)
                StateLbl.Text = on and "ENABLED" or "DISABLED"
                StateLbl.TextColor3 = on and UI.Theme.Success or UI.Theme.TextMuted
            end
            paintState(Feature.Enabled)
            table.insert(Feature.Listeners, paintState)
            addThemeRefresher(function() paintState(Feature.Enabled) end)

            local TopSwitch = createSwitch(Top, UDim2.new(1, -40, 0.5, -11), Feature.Enabled, function(v) Feature:SetEnabled(v, true) end)
            table.insert(Feature.Switches, TopSwitch)

            local TopLine = create("Frame", { Size = UDim2.new(1, -10, 0, 1), Position = UDim2.fromOffset(0, 44), BorderSizePixel = 0 }, root)
            themeObject(TopLine, "BackgroundColor3", "Border")

            local Scroll = createScroll(root)
            Scroll.Position = UDim2.fromOffset(0, 54)
            Scroll.Size = UDim2.new(1, 0, 1, -54)
            create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, Scroll)
            local Body = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1 }, Scroll)
            create("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
            }, Body)
            create("Frame", { Size = UDim2.new(1, 0, 0, 10), BackgroundTransparency = 1, LayoutOrder = 2 }, Scroll)

            local Settings = {
                Root = root, Scroll = Scroll, Container = Body, ConfigKey = Feature.Name,
                Values = Feature.Elements, Feature = Feature, Tab = Feature.Tab, Wrap = true,
            }
            attachElements(Settings)
            Feature.SettingsPage = Settings
            Strip.Visible = true
            NoSettings.Visible = false
        end
        if callback then callback(Feature.SettingsPage) end
        return Feature
    end

    for _, method in ipairs({
        "AddToggle", "AddSlider", "AddDropdown", "AddMultiDropdown", "AddChips", "AddItemSelector", "AddKeybind",
        "AddLabel", "AddButton", "AddHeader", "AddColorPicker", "AddTextBox", "AddParagraph", "AddDivider", "AddButtonRow",
    }) do
        Feature[method] = function(_, ...)
            local settings = Feature:Configure()
            settings[method](settings, ...)
            return Feature
        end
    end
    Feature.AddGroup = function(_, ...)
        return Feature:Configure():AddGroup(...)
    end

    updateStatus()
    return Feature
end

