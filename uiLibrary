local Pages = {}
local currentRoot = nil
local pageToken = 0
local hideTooltip -- определяется ниже

local function createPageRoot()
    local root = create("CanvasGroup", {
        Name = "Page", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        Visible = false, GroupTransparency = 1,
    }, PageContainer)
    table.insert(Pages, root)
    return root
end

local function createScroll(root)
    local scroll = create("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageTransparency = 0.25, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
    }, root)
    themeObject(scroll, "ScrollBarImageColor3", "Accent")
    create("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 2) }, scroll)
    return scroll
end

local function showPage(root, dx, dy)
    pageToken += 1
    local token = pageToken
    local old = currentRoot
    if hideTooltip then hideTooltip() end

    for _, page in ipairs(Pages) do
        if page ~= root and page ~= old then page.Visible = false end
    end
    if old and old ~= root then
        tween(old, 0.12, { GroupTransparency = 1 })
        task.delay(0.13, function()
            if token == pageToken and old ~= currentRoot then old.Visible = false end
        end)
    end

    root.Position = UDim2.fromOffset(dx or 0, dy or 14)
    root.GroupTransparency = 1
    root.Visible = true
    tween(root, 0.34, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, Enum.EasingStyle.Quint)
    currentRoot = root
end

