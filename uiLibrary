	function obj:AddSlider(name, min, max, default, callback, step, opts)
		opts = opts or {}
		min = tonumber(min) or 0
		max = tonumber(max) or 100
		if max < min then min, max = max, min end
		step = tonumber(step) or 1
		if step <= 0 then step = 1 end
		local suffix = opts.Suffix or ""
		local decimals = step < 1 and math.max(0, math.ceil(-math.log10(step) - 1e-9)) or 0

		local function round(v)
			local r = math.floor((v - min) / step + 0.5) * step + min
			r = math.clamp(r, min, max)
			if decimals > 0 then r = tonumber(string.format("%." .. decimals .. "f", r)) end
			return r
		end
		local function fmt(v) return string.format("%." .. decimals .. "f", v) .. suffix end

		local value = round(tonumber(default) or min)
		store(name, value)

		local Row = createRow(false, 58, opts.Description)
		rowLabel(Row, name, nil, 96, 32)

		local Box = create("TextBox", {
			Size = UDim2.fromOffset(72, 22), Position = UDim2.new(1, -86, 0, 6), BorderSizePixel = 0,
			Text = fmt(value), Font = Enum.Font.GothamBold, TextSize = 11, ClearTextOnFocus = false,
		}, Row)
		corner(Box, 6)
		themeObject(Box, "BackgroundColor3", "Element")
		themeObject(Box, "TextColor3", "Accent")

		local Track = create("Frame", { Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 40), BorderSizePixel = 0 }, Row)
		corner(Track, 3)
		themeObject(Track, "BackgroundColor3", "ElementHover")
		local Fill = create("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, Track)
		corner(Fill, 3)
		themeObject(Fill, "BackgroundColor3", "Accent")
		local Knob = create("Frame", {
			Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BorderSizePixel = 0,
		}, Track)
		corner(Knob, 999)
		themeObject(Knob, "BackgroundColor3", "Text")
		local KnobStroke = stroke(Knob, "Accent", 2)
		local Hit = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0.5, -13), BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
		}, Track)

		local function paint(v, smooth)
			local p = max == min and 0 or (v - min) / (max - min)
			if smooth then
				tween(Fill, 0.25, { Size = UDim2.new(p, 0, 1, 0) }, Enum.EasingStyle.Quint)
				tween(Knob, 0.25, { Position = UDim2.new(p, 0, 0.5, 0) }, Enum.EasingStyle.Quint)
			else
				Fill.Size = UDim2.new(p, 0, 1, 0)
				Knob.Position = UDim2.new(p, 0, 0.5, 0)
			end
			Box.Text = fmt(v)
		end
		paint(value, false)

		local function setValue(v, fire, smooth)
			v = round(v)
			value = v
			store(name, v)
			paint(v, smooth)
			if fire and callback then task.spawn(callback, v) end
		end
		register(name, function(v, invoke) setValue(tonumber(v) or value, invoke, true) end)

		local function grow(on)
			tween(Knob, 0.18, { Size = on and UDim2.fromOffset(19, 19) or UDim2.fromOffset(14, 14) }, Enum.EasingStyle.Back)
			tween(KnobStroke, 0.18, { Thickness = on and 3 or 2 })
		end

		local function fromX(x)
			local w = math.max(Track.AbsoluteSize.X, 1)
			local p = math.clamp((x - Track.AbsolutePosition.X) / w, 0, 1)
			return round(min + (max - min) * p)
		end

		connect(Hit.InputBegan, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local moveConn, endConn
			local finished = false
			grow(true)
			local function finish()
				if finished then return end
				finished = true
				grow(false)
				if moveConn then moveConn:Disconnect() end
				if endConn then endConn:Disconnect() end
				if opts.Commit and callback then task.spawn(callback, value) end
			end
			setValue(fromX(input.Position.X), not opts.Commit, false)
			moveConn = UserInputService.InputChanged:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
					local v = fromX(i.Position.X)
					if v ~= value then setValue(v, not opts.Commit, false) end
				end
			end)
			endConn = UserInputService.InputEnded:Connect(function(i)
				if i == input or i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					finish()
				end
			end)
		end)

		connect(Box.FocusLost, function()
			local n = tonumber(string.match(Box.Text, "-?%d+%.?%d*"))
			if n then setValue(n, true, true) else paint(value, false) end
		end)
		return obj
	end

