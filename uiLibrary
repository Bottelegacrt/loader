	function obj:AddMultiDropdown(name, options, defaults, callback, opts)
		opts = opts or {}
		local items = normalizeItems(options)
		local selected = {}
		for _, item in ipairs(items) do selected[item.Key] = containsValue(defaults or {}, item.Key) end

		local function getList()
			local r = {}
			for _, item in ipairs(items) do if selected[item.Key] then table.insert(r, item.Value) end end
			return r
		end
		store(name, getList())

		local Row = createRow(true, 50, opts.Description)
		rowLabel(Row, name, opts.Description, 148)
		local Button = dropdownButton(Row, "")

		local function updateText()
			local list = getList()
			if #list == 0 then Button.Text = "None"
			elseif #list == 1 then Button.Text = nameOf(items, list[1])
			else Button.Text = #list .. " selected" end
		end
		updateText()

		register(name, function(values, invoke)
			selected = {}
			for _, item in ipairs(items) do selected[item.Key] = containsValue(values or {}, item.Key) end
			local list = getList()
			store(name, list)
			updateText()
			if invoke and callback then task.spawn(callback, list) end
		end, opts.NoSave)
		connect(Button.MouseButton1Click, function()
			UI:OpenPopup(Button, options, true, getList(), function(values) obj.Controls[name](values, true) end, name)
		end)
		return obj
	end

	function obj:AddChips(name, options, defaults, callback, opts)
		opts = opts or {}
		local multi = opts.Multi ~= false
		local items = normalizeItems(options)
		local selected = {}

		local function setSelection(v)
			selected = {}
			if multi then
				for _, item in ipairs(items) do selected[item.Key] = containsValue(v or {}, item.Key) end
			elseif v ~= nil then
				selected[tostring(v)] = true
			end
		end
		if multi then
			setSelection(defaults)
		else
			setSelection(defaults ~= nil and defaults or (items[1] and items[1].Value))
		end

		local function getValue()
			if multi then
				local r = {}
				for _, item in ipairs(items) do if selected[item.Key] then table.insert(r, item.Value) end end
				return r
			end
			for _, item in ipairs(items) do if selected[item.Key] then return item.Value end end
			return nil
		end
		store(name, getValue())

		local Row = create("Frame", { Size = fullSize(0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0, LayoutOrder = nextOrder() }, obj.Container)
		corner(Row, 9)
		surface(Row, "Panel", 0)
