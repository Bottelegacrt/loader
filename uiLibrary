local function getGroup(Tab)
	local last = Tab.LastGroup
	if last and last.Order == Tab.Order then return last end
	Tab.Order += 1
	local Frame = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = Tab.Order }, Tab.Scroll)
	create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0, CARD_H), CellPadding = UDim2.fromOffset(8, 8),
		FillDirection = Enum.FillDirection.Horizontal, FillDirectionMaxCells = 2, SortOrder = Enum.SortOrder.LayoutOrder,
	}, Frame)
	local group = { Frame = Frame, Order = Tab.Order }
	Tab.LastGroup = group
	table.insert(Tab.Groups, group)
	return group
end

function UI:CreateTab(name, icon, description)
	local Tab = {
		Name = tostring(name or "Tab"), Description = description, Features = {}, Groups = {}, Sections = {}, Order = 0,
	}
	local key = Tab.Name
	if UI.Tabs[key] then
		local n = 2
		while UI.Tabs[key .. " " .. n] do n += 1 end
		key = key .. " " .. n
		Tab.Name = key
	end
	UI.Tabs[key] = Tab
	table.insert(UI.TabList, Tab)

	Tab.Root = createPageRoot()
	Tab.Scroll = createScroll(Tab.Root)
	Tab.Layout = create("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, Tab.Scroll)
	create("Frame", { Size = UDim2.new(1, 0, 0, 10), BackgroundTransparency = 1, LayoutOrder = 100000 }, Tab.Scroll)

	Tab.Empty = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0.4, 0), BackgroundTransparency = 1,
		Text = "No matching features", Font = Enum.Font.GothamMedium, TextSize = 12, Visible = false,
	}, Tab.Root)
	themeObject(Tab.Empty, "TextColor3", "TextMuted")

	createTabButton(Tab, icon)

	function Tab:AddSection(title)
		Tab.Order += 1
		local Frame = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = Tab.Order }, Tab.Scroll)
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		}, Frame)
		table.insert(Tab.Sections, Frame)

		local Section = { Container = Frame, ConfigKey = tostring(title), Tab = Tab, Wrap = true }
		attachElements(Section)
		Section:AddHeader(title)
		return Section
	end

	function Tab:CreateFeature(options)
		return UI:CreateFeature(Tab, options)
	end

	if not UI.CurrentTab then
		task.defer(function()
			if not UI.CurrentTab then UI:OpenTab(Tab) end
		end)
	end
	return Tab
end

local function applyFilter()
	local Tab = UI.CurrentTab
	if not Tab or UI.CurrentPage ~= "tab" then return end
	local query = string.lower(Search.Text)
	local any = false

	for _, g in ipairs(Tab.Groups) do g.Frame.Visible = false end
	for _, Feature in ipairs(Tab.Features) do
		local match = query == "" or string.find(Feature.SearchName, query, 1, true) ~= nil
		Feature.Card.Visible = match
		if match then
			any = true
			Feature.Group.Frame.Visible = true
		end
	end
	for _, sec in ipairs(Tab.Sections) do sec.Visible = (query == "") end
	Tab.Empty.Visible = query ~= "" and not any
end
connect(Search:GetPropertyChangedSignal("Text"), applyFilter)

function UI:OpenTab(Tab, force)
	if type(Tab) == "string" then Tab = UI.Tabs[Tab] end
	if not Tab then return end
	if UI.CurrentTab == Tab and UI.CurrentPage == "tab" and not force then return end

	local fromSettings = UI.CurrentPage == "settings"
	UI:ClosePopup()
	UI.CurrentTab = Tab
	UI.CurrentPage = "tab"
	UI.CurrentFeature = nil

	Search.Visible = true
	Search.Text = ""
	PageTitle.Text = Tab.Name
	PageDescription.Text = Tab.Description
		or (#Tab.Features > 0 and ("Configure your " .. string.lower(Tab.Name) .. " features") or "Preferences")

	for _, t in ipairs(UI.TabList) do t.ApplyVisual(false) end
	Tab.Scroll.CanvasPosition = Vector2.new(0, 0)
	applyFilter()
	if fromSettings then showPage(Tab.Root, -24, 0) else showPage(Tab.Root, 0, 14) end
end

function UI:OpenFeatureSettings(Feature)
	if not Feature or not Feature.SettingsPage then return end
	UI:ClosePopup()
	UI.CurrentFeature = Feature
	UI.CurrentPage = "settings"

	Search.Visible = false
	PageTitle.Text = Feature.Name
	PageDescription.Text = Feature.Tab.Name .. "  ›  Configuration"
	Feature.SettingsPage.Scroll.CanvasPosition = Vector2.new(0, 0)
	showPage(Feature.SettingsPage.Root, 24, 0)
end

function UI:CreateFeature(Tab, options)
	if type(Tab) == "string" then Tab = UI.Tabs[Tab] end
	options = options or {}

	local Feature = {
		Name = tostring(options.Name or "Feature"),
		Description = tostring(options.Description or ""),
		Icon = options.Icon,
		Enabled = options.Enabled == true,
		Elements = {},
		Tab = Tab,
		Switches = {},
	}
	Feature.SearchName = string.lower(Feature.Name .. " " .. Feature.Description)

	table.insert(Tab.Features, Feature)
	table.insert(UI.Features, Feature)
	UI.Config[Feature.Name] = { Enabled = Feature.Enabled }
	UI.Registry[Feature.Name] = UI.Registry[Feature.Name] or {}
	UI.Registry[Feature.Name].Enabled = function(v, invoke) Feature:SetEnabled(v, invoke) end
	Tab.Badge.Text = tostring(#Tab.Features)

	local group = getGroup(Tab)
	Feature.Group = group

	local Card = create("TextButton", {
		BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = #Tab.Features,
	}, group.Frame)
	corner(Card, 10)
	surface(Card, "Panel", 0.1)
	local CardStroke = create("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Card)
	Feature.Card = Card

	createGlyph(Card, Feature.Icon, Feature.Name, 32, UDim2.fromOffset(12, 12), 9)

	local NameLabel = create("TextLabel", {
		Size = UDim2.new(1, -140, 0, 18), Position = UDim2.fromOffset(52, 9), BackgroundTransparency = 1,
		Text = Feature.Name, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, Card)
	themeObject(NameLabel, "TextColor3", "Text")

	local DescLabel = create("TextLabel", {
		Size = UDim2.new(1, -140, 0, 14), Position = UDim2.fromOffset(52, 29), BackgroundTransparency = 1,
		Text = Feature.Description, Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, Card)
	themeObject(DescLabel, "TextColor3", "TextMuted")

	local hovered = false
	local function paintCard(instant)
		local on = Feature.Enabled
		applyProps(CardStroke, {
			Color = on and UI.Theme.Accent or (hovered and UI.Theme.TextDark or UI.Theme.Border),
			Transparency = on and (hovered and 0.15 or 0.45) or 0,
		}, instant)
	end
	paintCard(true)
	addThemeRefresher(function() paintCard(true) end)
	connect(Card.MouseEnter, function() hovered = true paintCard() end)
	connect(Card.MouseLeave, function() hovered = false paintCard() end)

	local tip = options.Tooltip or (#Feature.Description > 18 and Feature.Description or nil)
	if tip then UI:AddTooltip(Card, tip) end

	local CardChip = createStateChip(Card, UDim2.new(1, -(PILL_W + 12), 0.5, -12), PILL_W, 24, Feature.Enabled, function(v) Feature:SetEnabled(v, true) end)
	table.insert(Feature.Switches, CardChip)

	local GearBtn = create("TextButton", {
		Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -38, 0.5, -13), BackgroundTransparency = 1, BorderSizePixel = 0,
		Text = "", AutoButtonColor = false, Visible = false,
	}, Card)
	corner(GearBtn, 8)
	themeObject(GearBtn, "BackgroundColor3", "ElementHover")
	local Gear = createGear(GearBtn, 16, UDim2.fromScale(0.5, 0.5))
	local gearHover = false
	local function paintGear(instant)
		applyProps(GearBtn, { BackgroundTransparency = gearHover and 0.35 or 1 }, instant)
		Gear:SetColor(gearHover and UI.Theme.Accent or UI.Theme.TextMuted, instant)
		if instant then
			Gear.Holder.Rotation = gearHover and 90 or 0
		else
			tween(Gear.Holder, 0.4, { Rotation = gearHover and 90 or 0 }, Enum.EasingStyle.Quint)
		end
	end
	paintGear(true)
	addThemeRefresher(function() paintGear(true) end)
	connect(GearBtn.MouseEnter, function() gearHover = true paintGear(false) end)
	connect(GearBtn.MouseLeave, function() gearHover = false paintGear(false) end)

	local function layoutCard()
		local extra = Feature.SettingsPage and 30 or 0
		local reserve = 52 + PILL_W + 12 + extra + 6
		NameLabel.Size = UDim2.new(1, -reserve, 0, 18)
		DescLabel.Size = UDim2.new(1, -reserve, 0, 14)
		CardChip.Button.Position = UDim2.new(1, -(PILL_W + 12 + extra), 0.5, -12)
	end
	layoutCard()

	connect(GearBtn.MouseButton1Click, function() UI:OpenFeatureSettings(Feature) end)
	connect(Card.MouseButton1Click, function()
		if Feature.SettingsPage then UI:OpenFeatureSettings(Feature) end
	end)

	function Feature:SetEnabled(state, invoke)
		state = state == true
		Feature.Enabled = state
		UI.Config[Feature.Name].Enabled = state
		for _, sw in ipairs(Feature.Switches) do sw:Set(state) end
		paintCard(false)
		updateStatus()
		UI:QueueAutosave()
		if invoke and Feature.EnableCallback then task.spawn(Feature.EnableCallback, state) end
		return Feature
	end

	function Feature:OnToggle(callback)
		Feature.EnableCallback = callback
		return Feature
	end

	function Feature:GetValue(name)
		return Feature.Elements[name]
	end

	function Feature:SetValue(name, value, invoke)
		local setter = UI.Registry[Feature.Name] and UI.Registry[Feature.Name][name]
		if setter then
			setter(value, invoke)
		else
			Feature.Elements[name] = value
			UI.Config[Feature.Name][name] = value
		end
		return Feature
	end

	function Feature:Configure(callback)
		if not Feature.SettingsPage then
			local root = createPageRoot()

			local Top = create("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1 }, root)
			local Back = create("TextButton", {
				Size = UDim2.fromOffset(88, 32), Position = UDim2.fromOffset(0, 4), BorderSizePixel = 0,
				Text = "‹   Back", Font = Enum.Font.GothamBold, TextSize = 12, AutoButtonColor = false,
			}, Top)
			corner(Back, 9)
			stroke(Back, "Border", 1)
			hoverStyle(Back, "Element", "Accent", "Text", "Text")
			withRipple(Back)
			connect(Back.MouseButton1Click, function() UI:OpenTab(Feature.Tab, true) end)

			local Sub = create("TextLabel", {
				Size = UDim2.new(1, -210, 1, 0), Position = UDim2.fromOffset(102, 0), BackgroundTransparency = 1,
				Text = Feature.Description ~= "" and Feature.Description or "Feature configuration",
				Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, Top)
			themeObject(Sub, "TextColor3", "TextMuted")

			local TopChip = createStateChip(Top, UDim2.new(1, -90, 0.5, -14), 80, 28, Feature.Enabled, function(v) Feature:SetEnabled(v, true) end)
			table.insert(Feature.Switches, TopChip)

			local TopLine = create("Frame", { Size = UDim2.new(1, -10, 0, 1), Position = UDim2.fromOffset(0, 44), BorderSizePixel = 0 }, root)
			themeObject(TopLine, "BackgroundColor3", "Border")

			local Scroll = createScroll(root)
			Scroll.Position = UDim2.fromOffset(0, 54)
			Scroll.Size = UDim2.new(1, 0, 1, -54)
			create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, Scroll)
			local Body = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1 }, Scroll)
			create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
			}, Body)
			create("Frame", { Size = UDim2.new(1, 0, 0, 10), BackgroundTransparency = 1, LayoutOrder = 2 }, Scroll)

			local Settings = {
				Root = root, Scroll = Scroll, Container = Body, ConfigKey = Feature.Name,
				Values = Feature.Elements, Feature = Feature, Tab = Feature.Tab, Wrap = true,
			}
			attachElements(Settings)
			Feature.SettingsPage = Settings
			GearBtn.Visible = true
			layoutCard()
		end
		if callback then callback(Feature.SettingsPage) end
		return Feature
	end

	for _, method in ipairs({
		"AddToggle", "AddSlider", "AddDropdown", "AddMultiDropdown", "AddChips", "AddItemSelector", "AddKeybind",
		"AddLabel", "AddButton", "AddHeader", "AddColorPicker", "AddTextBox", "AddParagraph", "AddDivider", "AddButtonRow",
		}) do
		Feature[method] = function(_, ...)
			local settings = Feature:Configure()
			settings[method](settings, ...)
			return Feature
		end
	end
	Feature.AddGroup = function(_, ...)
		return Feature:Configure():AddGroup(...)
	end

	updateStatus()
	return Feature
end

