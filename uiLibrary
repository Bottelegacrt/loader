	if state then
		SidePanel.Visible = true
		SidePanel.GroupTransparency = 1
		SidePanel.Position = UDim2.fromOffset(BASE_W - 40, 0)
		tween(SidePanel, 0.42, { Position = UDim2.fromOffset(BASE_W + PANEL_GAP, 0), GroupTransparency = UI.Visible and 0 or 1 }, Enum.EasingStyle.Quint)
