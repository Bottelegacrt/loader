local function clearParticles()
	for _, p in ipairs(Particles) do
		if p.o then p.o:Destroy() end
	end
	Particles = {}
end

function UI:SetEffect(name)
	if not Effects[name] then name = "None" end
	UI.Effect = name
	clearParticles()
	local def = Effects[name]
	if not def then return end
	for i = 1, def.Count(UI.EffectDensity) do
		local p = { i = i }
		def.Make(p)
		def.Spawn(p, true)
		def.Paint(p)
		Particles[i] = p
	end
end

function UI:SetEffectDensity(value)
	UI.EffectDensity = math.clamp(math.floor(tonumber(value) or 40), 5, 200)
	if UI.Effect ~= "None" then UI:SetEffect(UI.Effect) end
end

function UI:SetEffectSpeed(value)
	UI.EffectSpeed = math.clamp(tonumber(value) or 100, 10, 400)
end

function UI:SetEffectIntensity(value)
	FX.GroupTransparency = 1 - math.clamp((tonumber(value) or 60) / 100, 0.05, 1)
end

connect(RunService.RenderStepped, function(dt)
	local def = Effects[UI.Effect]
	if not def or not UI.Visible then return end
	dt = math.min(dt, 0.1) * (UI.EffectSpeed / 100)
	fxClock += dt
	for _, p in ipairs(Particles) do def.Update(p, dt, fxClock) end
end)

addThemeRefresher(function()
	local def = Effects[UI.Effect]
	if not def then return end
	for _, p in ipairs(Particles) do def.Paint(p) end
end)

local HasFS = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
	and type(makefolder) == "function" and type(isfolder) == "function" and type(listfiles) == "function"
local ROOT_DIR, CONFIG_DIR = "Loyalty", "Loyalty/configs"
local THEMES_FILE = ROOT_DIR .. "/themes.json"
local AUTO_NAME = "auto"
local Memory, MemoryAutoload, MemoryThemes = {}, nil, nil

local function safeName(name)
	local n = tostring(name or ""):gsub("[^%w%-_ ]", "")
	return (n:match("^%s*(.-)%s*$"))
end

local function ensureDirs()
	if not HasFS then return end
	pcall(function()
		if not isfolder(ROOT_DIR) then makefolder(ROOT_DIR) end
		if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
	end)
end

local function encodeValue(v)
	local t = typeof(v)
	if t == "EnumItem" then
		return { __t = "Enum", Type = tostring(v.EnumType), Name = v.Name }
	elseif t == "Color3" then
		return { __t = "Color3", R = v.R, G = v.G, B = v.B }
	elseif t == "table" then
		local r = {}
		for i, x in ipairs(v) do r[i] = encodeValue(x) end
		return r
	elseif t == "number" or t == "string" or t == "boolean" then
		return v
	end
	return nil
end

local function decodeValue(v)
	if type(v) == "table" then
		if v.__t == "Enum" then
			local ok, r = pcall(function() return Enum[v.Type][v.Name] end)
			return ok and r or nil
		elseif v.__t == "Color3" then
			return Color3.new(v.R, v.G, v.B)
		end
		local r = {}
		for i, x in ipairs(v) do r[i] = decodeValue(x) end
		return r
	end
	return v
end

function UI:GetConfigData()
	local data = {}
	for key, setters in pairs(UI.Registry) do
		local values = UI.Config[key]
		if values then
			local entry = {}
			for name in pairs(setters) do
				local v = values[name]
				if v ~= nil then
					local e = encodeValue(v)
					if e ~= nil then entry[name] = e end
				end
			end
			data[key] = entry
		end
	end
	return { Version = 1, Data = data }
end

function UI:ApplyConfigData(payload)
	local data = type(payload) == "table" and (payload.Data or payload) or nil
	if type(data) ~= "table" then return false end
	for key, entry in pairs(data) do
		local setters = UI.Registry[key]
		if setters and type(entry) == "table" then
			for name, raw in pairs(entry) do
				local setter = setters[name]
				if setter then pcall(setter, decodeValue(raw), true) end
			end
		end
	end
	return true
end

function UI:ListConfigs()
	local list = {}
	if HasFS then
		ensureDirs()
		local ok, files = pcall(listfiles, CONFIG_DIR)
		if ok and type(files) == "table" then
			for _, path in ipairs(files) do
				local name = tostring(path):match("([^/\\]+)%.json$")
				if name then table.insert(list, name) end
			end
		end
	else
		for name in pairs(Memory) do table.insert(list, name) end
	end
	table.sort(list, function(a, b) return a:lower() < b:lower() end)
	return list
end

local function configExists(name)
	if HasFS then
		local ok, exists = pcall(isfile, CONFIG_DIR .. "/" .. name .. ".json")
		return ok and exists == true
	end
	return Memory[name] ~= nil
end

function UI:SaveConfig(name)
	name = safeName(name)
	if name == "" then return false, "Enter a config name" end
	local ok, json = pcall(function() return HttpService:JSONEncode(UI:GetConfigData()) end)
	if not ok then return false, "Failed to encode config" end
	if HasFS then
		ensureDirs()
		local wok, err = pcall(writefile, CONFIG_DIR .. "/" .. name .. ".json", json)
		if not wok then return false, tostring(err) end
	else
		Memory[name] = json
	end
	return true
end

local autoToken = 0
function UI:QueueAutosave()
	if not UI.AutoReady or UI.Loading or not UI.AutoConfig then return end
	UI.AutoDirty = true
	autoToken += 1
	local token = autoToken
	task.delay(0.7, function()
		if token == autoToken and UI.AutoReady and UI.AutoConfig and UI.AutoDirty then
			UI.AutoDirty = false
			UI:SaveConfig(AUTO_NAME)
		end
	end)
end

function UI:LoadConfig(name)
	name = safeName(name)
	if name == "" then return false, "Select a config" end
	local json
	if HasFS then
		local path = CONFIG_DIR .. "/" .. name .. ".json"
		local ok, exists = pcall(isfile, path)
		if not ok or not exists then return false, "Config not found" end
		local rok, content = pcall(readfile, path)
		if not rok then return false, tostring(content) end
		json = content
	else
		json = Memory[name]
		if not json then return false, "Config not found" end
	end
	local ok, decoded = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok then return false, "Config file is corrupted" end
	UI.Loading = true
	pcall(function() UI:ApplyConfigData(decoded) end)
	UI.Loading = false
	UI:QueueAutosave()
	return true
end

function UI:DeleteConfig(name)
	name = safeName(name)
	if name == "" then return false, "Select a config" end
	if HasFS then
		if type(delfile) ~= "function" then return false, "delfile is not supported by your executor" end
		local ok, err = pcall(delfile, CONFIG_DIR .. "/" .. name .. ".json")
		if not ok then return false, tostring(err) end
	else
		Memory[name] = nil
	end
	if UI:GetAutoload() == name then UI:SetAutoload(nil) end
	return true
end

function UI:GetAutoload()
	if HasFS then
		local ok, exists = pcall(isfile, ROOT_DIR .. "/autoload.txt")
		if ok and exists then
			local rok, content = pcall(readfile, ROOT_DIR .. "/autoload.txt")
			if rok then
				local n = safeName(content)
				return n ~= "" and n or nil
			end
		end
		return nil
	end
	return MemoryAutoload
end

function UI:SetAutoload(name)
	name = name and safeName(name) or nil
	if name == "" then name = nil end
	if HasFS then
		ensureDirs()
		pcall(writefile, ROOT_DIR .. "/autoload.txt", name or "")
	else
		MemoryAutoload = name
	end
end

function UI:LoadAutoload()
	local name = UI:GetAutoload()
	if not name or not configExists(name) then name = AUTO_NAME end
	local loaded = false
	if configExists(name) then
		local ok, err = UI:LoadConfig(name)
		loaded = ok
		if ok then
			UI:Notify("Config loaded", "Autoload: " .. name, 3, "success")
		else
			UI:Notify("Autoload failed", tostring(err), 4, "error")
		end
	end
	UI.AutoReady = true
	return loaded
end

local function saveThemes()
	local out = {}
	for name in pairs(UI.Custom) do
		local theme = UI.Themes[name]
		if theme then
			local e = {}
			for _, k in ipairs(COLOR_KEYS) do
				local c = theme[k]
				e[k] = { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
			end
			out[name] = e
		end
	end
	local ok, json = pcall(function() return HttpService:JSONEncode(out) end)
	if not ok then return end
	if HasFS then
		ensureDirs()
		pcall(writefile, THEMES_FILE, json)
	else
		MemoryThemes = json
	end
end

local function loadThemes()
	local json
	if HasFS then
		local ok, exists = pcall(isfile, THEMES_FILE)
		if ok and exists then
			local rok, content = pcall(readfile, THEMES_FILE)
			if rok then json = content end
		end
	else
		json = MemoryThemes
	end
	if not json then return end
	local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok or type(data) ~= "table" then return end
	local names = {}
	for name in pairs(data) do
		if type(name) == "string" and not UI.Themes[name] then table.insert(names, name) end
	end
	table.sort(names, function(a, b) return a:lower() < b:lower() end)
	for _, name in ipairs(names) do
		local entry = data[name]
		if type(entry) == "table" then
			local colors = {}
			for _, k in ipairs(COLOR_KEYS) do
				local v = entry[k]
				if type(v) == "table" and #v == 3 then colors[k] = Color3.fromRGB(v[1], v[2], v[3]) end
			end
			UI.Themes[name] = fullTheme(colors)
			UI.Custom[name] = true
			table.insert(UI.ThemeOrder, name)
		end
	end
end

function UI:SaveTheme(name, colors)
	name = safeName(name)
	if name == "" then return false, "Enter a theme name" end
	if UI.Themes[name] and not UI.Custom[name] then return false, "This name is reserved" end
	local isNew = UI.Themes[name] == nil
	UI.Themes[name] = fullTheme(colors)
	UI.Custom[name] = true
	if isNew then table.insert(UI.ThemeOrder, name) end
	saveThemes()
	return true
end

function UI:DeleteTheme(name)
	name = safeName(name)
	if not UI.Custom[name] then return false, "Only custom themes can be deleted" end
	UI.Themes[name] = nil
	UI.Custom[name] = nil
	for i, n in ipairs(UI.ThemeOrder) do
		if n == name then
			table.remove(UI.ThemeOrder, i)
			break
		end
	end
	saveThemes()
	return true
end

