    function obj:AddMultiDropdown(name, options, defaults, callback, opts)
        opts = opts or {}
        local items = normalizeItems(options)
        local selected = {}
        for _, item in ipairs(items) do selected[item.Key] = containsValue(defaults or {}, item.Key) end

        local function getList()
            local r = {}
            for _, item in ipairs(items) do if selected[item.Key] then table.insert(r, item.Value) end end
            return r
        end
        store(name, getList())

        local Row = createRow(true, 50, opts.Description)
        rowLabel(Row, name, opts.Description, 148)
        local Button = dropdownButton(Row, "")

        local function updateText()
            local list = getList()
            if #list == 0 then Button.Text = "None"
            elseif #list == 1 then Button.Text = nameOf(items, list[1])
            else Button.Text = #list .. " selected" end
        end
        updateText()

        register(name, function(values, invoke)
            selected = {}
            for _, item in ipairs(items) do selected[item.Key] = containsValue(values or {}, item.Key) end
            local list = getList()
            store(name, list)
            updateText()
            if invoke and callback then task.spawn(callback, list) end
        end, opts.NoSave)
        connect(Button.MouseButton1Click, function()
            UI:OpenPopup(Button, options, true, getList(), function(values) obj.Controls[name](values, true) end, name)
        end)
        return obj
    end

    -- чипсы: выбранный чип подсвечивается цветом элемента, слева появляется галочка,
    -- а сам чип плавно расширяется. Без цветных точек.
    function obj:AddChips(name, options, defaults, callback, opts)
        opts = opts or {}
        local multi = opts.Multi ~= false
        local items = normalizeItems(options)
        local selected = {}

        local function setSelection(v)
            selected = {}
            if multi then
                for _, item in ipairs(items) do selected[item.Key] = containsValue(v or {}, item.Key) end
            elseif v ~= nil then
                selected[tostring(v)] = true
            end
        end
        if multi then
            setSelection(defaults)
        else
            setSelection(defaults ~= nil and defaults or (items[1] and items[1].Value))
        end

        local function getValue()
            if multi then
                local r = {}
                for _, item in ipairs(items) do if selected[item.Key] then table.insert(r, item.Value) end end
                return r
            end
            for _, item in ipairs(items) do if selected[item.Key] then return item.Value end end
            return nil
        end
        store(name, getValue())

        local Row = create("Frame", { Size = fullSize(0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0, LayoutOrder = nextOrder() }, obj.Container)
        corner(Row, 9)
        surface(Row, "Panel", 0)
        stroke(Row, "Border", 1)
        create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 11), PaddingBottom = UDim.new(0, 12) }, Row)
        create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, Row)

        local Head = create("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = 1 }, Row)
        local Label = create("TextLabel", {
            Size = UDim2.new(1, -190, 1, 0), BackgroundTransparency = 1, Text = tostring(name), Font = Enum.Font.GothamBold,
            TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        }, Head)
        themeObject(Label, "TextColor3", "Text")
        local Counter = create("TextLabel", {
            Size = multi and UDim2.new(0, 60, 1, 0) or UDim2.new(0, 190, 1, 0),
            Position = multi and UDim2.new(1, -158, 0, 0) or UDim2.new(1, -190, 0, 0),
            BackgroundTransparency = 1, Text = "", Font = Enum.Font.GothamMedium, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right,
        }, Head)
        themeObject(Counter, "TextColor3", multi and "TextMuted" or "Accent")

        local Area = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2 }, Row)
        create("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
        }, Area)

        local chips = {}

        local function updateCounter()
            if multi then
                local n = 0
                for _, item in ipairs(items) do if selected[item.Key] then n += 1 end end
                Counter.Text = n .. " / " .. #items
            else
                local v = getValue()
                Counter.Text = v ~= nil and nameOf(items, v) or ""
            end
        end

        local function paintChip(c, instant, hover)
            local on = selected[c.Item.Key] == true
            local col = c.Item.Color or UI.Theme.Accent
            applyProps(c.Button, {
                BackgroundColor3 = on and col or (hover and UI.Theme.ElementHover or UI.Theme.Element),
                BackgroundTransparency = on and 0.8 or 0,
                Size = UDim2.fromOffset(on and c.Width + 14 or c.Width, 28),
            }, instant)
            applyProps(c.Stroke, { Color = on and col or (hover and UI.Theme.TextDark or UI.Theme.Border) }, instant)
            applyProps(c.Label, {
                TextColor3 = on and tint(col) or UI.Theme.TextMuted,
                Position = UDim2.fromOffset(on and 24 or 12, 0),
            }, instant)
            applyProps(c.Check, { TextTransparency = on and 0 or 1, TextColor3 = tint(col) }, instant)
        end
        local function paintAll(instant)
            for _, c in ipairs(chips) do paintChip(c, instant) end
            updateCounter()
        end

        local function fire()
            local v = getValue()
            store(name, v)
            if callback then task.spawn(callback, v) end
        end

        for i, item in ipairs(items) do
            local baseW = math.ceil(textWidth(item.Name, 11, Enum.Font.GothamMedium)) + 24
            local Chip = create("TextButton", {
                Size = UDim2.fromOffset(baseW, 28), BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = i,
            }, Area)
            corner(Chip, 14)
            local ChipStroke = create("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Chip)
            local Check = create("TextLabel", {
                Size = UDim2.fromOffset(12, 28), Position = UDim2.fromOffset(9, 0), BackgroundTransparency = 1,
                Text = "✓", Font = Enum.Font.GothamBold, TextSize = 11, TextTransparency = 1,
            }, Chip)
            local ChipLabel = create("TextLabel", {
                Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1, Text = item.Name,
                Font = Enum.Font.GothamMedium, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
            }, Chip)
            local c = { Button = Chip, Stroke = ChipStroke, Item = item, Label = ChipLabel, Check = Check, Width = baseW }
            chips[i] = c

            connect(Chip.MouseEnter, function() if not selected[item.Key] then paintChip(c, false, true) end end)
            connect(Chip.MouseLeave, function() paintChip(c, false, false) end)
            connect(Chip.MouseButton1Click, function()
                if multi then
                    selected[item.Key] = not selected[item.Key]
                else
                    selected = { [item.Key] = true }
                end
                paintAll(false)
                fire()
            end)
        end

        if multi then
            local function smallButton(text, x)
                local b = create("TextButton", {
                    Size = UDim2.fromOffset(44, 20), Position = UDim2.new(1, x, 0, 0), BorderSizePixel = 0,
                    Text = text, Font = Enum.Font.GothamMedium, TextSize = 10, AutoButtonColor = false,
                }, Head)
                corner(b, 6)
                hoverStyle(b, "Element", "ElementHover", "TextMuted", "Text")
                return b
            end
            local AllBtn, NoneBtn = smallButton("All", -92), smallButton("None", -44)
            connect(AllBtn.MouseButton1Click, function()
                for _, item in ipairs(items) do selected[item.Key] = true end
                paintAll(false) fire()
            end)
            connect(NoneBtn.MouseButton1Click, function()
                selected = {}
                paintAll(false) fire()
            end)
        end

        addThemeRefresher(function() paintAll(true) end)
        paintAll(true)

        register(name, function(v, invoke)
            setSelection(v)
            paintAll(false)
            store(name, getValue())
            if invoke and callback then task.spawn(callback, getValue()) end
        end, opts.NoSave)
        return obj
    end

    function obj:AddItemSelector(name, items, defaults, callback, opts)
        opts = opts or {}
        opts.Multi = true
        return obj:AddChips(name, items, defaults, callback, opts)
    end

    -- callback срабатывает при НАЖАТИИ клавиши, onChanged при переназначении
    function obj:AddKeybind(name, default, callback, onChanged, opts)
        opts = opts or {}
        local key = default or Enum.KeyCode.Unknown
        store(name, key)

        local Row = createRow(true, 50, opts.Description)
        rowLabel(Row, name, opts.Description, 110)
        local Button = create("TextButton", {
            Size = UDim2.fromOffset(98, 28), Position = UDim2.new(1, -110, 0.5, -14), BorderSizePixel = 0,
            Font = Enum.Font.GothamBold, TextSize = 10, AutoButtonColor = false, Text = "",
        }, Row)
        corner(Button, 7)
        themeObject(Button, "BackgroundColor3", "Element")
        local BtnStroke = stroke(Button, "Border", 1)

        local listening = false
        local function paint()
            if listening then
                Button.Text = "PRESS KEY"
                Button.TextColor3 = UI.Theme.TextMuted
                BtnStroke.Color = UI.Theme.Accent
            else
                Button.Text = key == Enum.KeyCode.Unknown and "NONE" or string.upper(key.Name)
                Button.TextColor3 = UI.Theme.Accent
                BtnStroke.Color = UI.Theme.Border
            end
        end
        paint()
        addThemeRefresher(paint)
        withRipple(Button)

        connect(Button.MouseButton1Click, function()
            listening = true
            UI.Listening = true
            paint()
        end)

        register(name, function(v, invoke)
            if typeof(v) ~= "EnumItem" then return end
            key = v
            store(name, key)
            paint()
            if invoke and onChanged then task.spawn(onChanged, key) end
        end, opts.NoSave)

        connect(UserInputService.InputBegan, function(input, processed)
            if listening then
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    listening = false UI.Listening = false paint()
                    return
                end
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                local newKey = input.KeyCode
                if newKey == Enum.KeyCode.Escape then
                    newKey = opts.AllowNone == false and key or Enum.KeyCode.Unknown
                end
                listening = false
                UI.Listening = false
                UI.LastBind = os.clock()
                key = newKey
                store(name, key)
                paint()
                if onChanged then task.spawn(onChanged, key) end
                return
            end
            if processed or UI.Listening then return end
            if key ~= Enum.KeyCode.Unknown and input.KeyCode == key and callback then
                task.spawn(callback, key)
            end
        end)
        return obj
    end

    function obj:AddColorPicker(name, default, callback, opts)
        opts = opts or {}
        local color = typeof(default) == "Color3" and default or Color3.fromRGB(255, 255, 255)
        store(name, color)

        local Row = createRow(true, 50, opts.Description)
        rowLabel(Row, name, opts.Description, 124)
        local Hex = create("TextLabel", {
            Size = UDim2.fromOffset(62, 50), Position = UDim2.new(1, -118, 0, 0), BackgroundTransparency = 1,
            Text = toHex(color), Font = Enum.Font.GothamMedium, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right,
        }, Row)
        themeObject(Hex, "TextColor3", "TextMuted")
        local Swatch = create("TextButton", {
            Size = UDim2.fromOffset(40, 24), Position = UDim2.new(1, -52, 0.5, -12), BorderSizePixel = 0, Text = "",
            AutoButtonColor = false, BackgroundColor3 = color,
        }, Row)
        corner(Swatch, 7)
        stroke(Swatch, "Border", 1)

        local function set(c, invoke)
            color = c
            store(name, c)
            Swatch.BackgroundColor3 = c
            Hex.Text = toHex(c)
            if invoke and callback then task.spawn(callback, c) end
        end
        register(name, function(v, invoke)
            if typeof(v) == "Color3" then set(v, invoke) end
        end, opts.NoSave)
        connect(Swatch.MouseButton1Click, function()
            UI:OpenColorPicker(Swatch, color, function(c) set(c, true) end, name)
        end)
        return obj
    end

    function obj:AddTextBox(name, default, callback, opts)
        opts = opts or {}
        local value = tostring(default or "")
        store(name, value)

        local Row = createRow(true, 50, opts.Description)
        rowLabel(Row, name, opts.Description, 152)
        local Box = create("TextBox", {
            Size = UDim2.fromOffset(140, 30), Position = UDim2.new(1, -152, 0.5, -15), BorderSizePixel = 0, Text = value,
            PlaceholderText = opts.Placeholder or "Type here...", Font = Enum.Font.GothamMedium, TextSize = 11,
            ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
        }, Row)
        corner(Box, 7)
        themeObject(Box, "BackgroundColor3", "Element")
        themeObject(Box, "TextColor3", "Text")
        themeObject(Box, "PlaceholderColor3", "TextDark")
        create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, Box)
        local BoxStroke = stroke(Box, "Border", 1)
        connect(Box.Focused, function() tween(BoxStroke, 0.15, { Color = UI.Theme.Accent }) end)

        local function set(text, invoke)
            if opts.Numeric then
                local n = tonumber(text)
                if n == nil then Box.Text = value return end
                text = tostring(n)
            end
            value = tostring(text)
            store(name, value)
            Box.Text = value
            if invoke and callback then task.spawn(callback, opts.Numeric and tonumber(value) or value) end
        end
        connect(Box.FocusLost, function()
            tween(BoxStroke, 0.15, { Color = UI.Theme.Border })
            set(Box.Text, true)
        end)
        register(name, function(v, invoke) set(tostring(v or ""), invoke) end, opts.NoSave)
        return obj
    end

    -- сворачиваемая группа внутри страницы; возвращает объект с тем же API элементов
    function obj:AddGroup(title, opts)
        opts = opts or {}
        local open = opts.Collapsed ~= true

        local Frame = create("Frame", { Size = fullSize(0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0, LayoutOrder = nextOrder() }, obj.Container)
        corner(Frame, 10)
        surface(Frame, "Panel", 0.4)
        stroke(Frame, "Border", 1)
        create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, Frame)

        local HeaderBtn = create("TextButton", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = 1 }, Frame)
        local HTitle = create("TextLabel", {
            Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(14, 0), BackgroundTransparency = 1, Text = string.upper(tostring(title)),
            Font = Enum.Font.GothamBold, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
        }, HeaderBtn)
        themeObject(HTitle, "TextColor3", "Accent")
        local Chevron = create("TextLabel", {
            Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -22, 0.5, 0),
            BackgroundTransparency = 1, Text = "›", Font = Enum.Font.GothamBold, TextSize = 18, Rotation = open and 90 or 0,
        }, HeaderBtn)
        themeObject(Chevron, "TextColor3", "TextMuted")

        local Wrapper = create("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = open and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
            BackgroundTransparency = 1, ClipsDescendants = true, LayoutOrder = 2, Visible = open,
        }, Frame)
        local Inner = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, Wrapper)
        create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10) }, Inner)
        create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, Inner)

        local gtoken = 0
        local function setOpen(state)
            open = state
            gtoken += 1
            local token = gtoken
            local s = RootScale.Scale
            tween(Chevron, 0.25, { Rotation = open and 90 or 0 }, Enum.EasingStyle.Quint)
            if open then
                Wrapper.Visible = true
                Wrapper.AutomaticSize = Enum.AutomaticSize.None
                Wrapper.Size = UDim2.new(1, 0, 0, 0)
                local target = Inner.AbsoluteSize.Y / s
                local tw = tween(Wrapper, 0.3, { Size = UDim2.new(1, 0, 0, target) }, Enum.EasingStyle.Quint)
                if tw then
                    tw.Completed:Connect(function()
                        if token == gtoken and open then
                            Wrapper.AutomaticSize = Enum.AutomaticSize.Y
                            Wrapper.Size = UDim2.new(1, 0, 0, 0)
                        end
                    end)
                end
            else
                local current = Wrapper.AbsoluteSize.Y / s
                Wrapper.AutomaticSize = Enum.AutomaticSize.None
                Wrapper.Size = UDim2.new(1, 0, 0, current)
                local tw = tween(Wrapper, 0.28, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint)
                if tw then
                    tw.Completed:Connect(function()
                        if token == gtoken and not open then Wrapper.Visible = false end
                    end)
                end
            end
        end
        connect(HeaderBtn.MouseButton1Click, function() setOpen(not open) end)

        local Group = { Container = Inner, ConfigKey = obj.ConfigKey, Values = obj.Values, Wrap = true, Tab = obj.Tab }
        attachElements(Group)
        return Group
    end
end

