local function computeScale()
    local vp = ScreenGui.AbsoluteSize
    local totalW = BASE_W + (UI.PanelOpen and (PANEL_GAP + PANEL_W) or 0)
    local fit = math.min((vp.X - 24) / totalW, (vp.Y - 24) / BASE_H)
    local wanted = UI.AutoScale and math.clamp(vp.Y / 1080, 0.75, 1.5) or (UI.UserScale / 100)
    return math.max(math.min(wanted, fit), 0.4)
end

local function applyScale(animate)
    local s = computeScale()
    UI.EffectiveScale = s
    if animate and UI.Visible then
        tween(RootScale, 0.25, { Scale = s }, Enum.EasingStyle.Quint)
    else
        RootScale.Scale = s
    end
    PopupScale.Scale = s
    TooltipScale.Scale = math.clamp(s, 0.8, 1.3)
    NotifScale.Scale = math.clamp(s, 0.7, 1.4)
end

