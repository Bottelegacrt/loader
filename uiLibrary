----------------------------------------------------------------------
-- ВВОД: горячая клавиша + перетаскивание окна
----------------------------------------------------------------------
connect(UserInputService.InputBegan, function(input, processed)
    if processed or UI.Listening or (os.clock() - UI.LastBind) < 0.25 then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == UI.MenuKeybind then
        UI:SetVisible(not UI.Visible)
    end
end)

local drag = { Active = false }

local function beginDrag(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    drag.Active = true
    drag.Start = input.Position
    drag.Origin = Root.Position
    input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then drag.Active = false end
    end)
end
connect(DragTitle.InputBegan, beginDrag)
connect(DragLogo.InputBegan, beginDrag)

connect(UserInputService.InputChanged, function(input)
    if not drag.Active then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local delta = input.Position - drag.Start
    local screen = ScreenGui.AbsoluteSize
    local w, h = Root.AbsoluteSize.X, Root.AbsoluteSize.Y

    local ox = drag.Origin.X.Offset + delta.X
    local oy = drag.Origin.Y.Offset + delta.Y
    local limitX = screen.X / 2 + w / 2 - 90
    ox = math.clamp(ox, -limitX, limitX)
    oy = math.clamp(oy, -(screen.Y / 2 - h / 2), screen.Y / 2 - 40 + h / 2)

    Root.Position = UDim2.new(drag.Origin.X.Scale, ox, drag.Origin.Y.Scale, oy)
end)

connect(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        drag.Active = false
    end
end)

