local PopupContent, PendingDestroy = nil, nil
local PopupOpen = false
local popupToken = 0

function UI:ClosePopup()
    if not PopupOpen then return end
    PopupOpen = false
    disconnectPopup()
    UI.PopupThemeObjects = {}
    popupToken += 1
    local token, content = popupToken, PopupContent
    PopupContent = nil
    PendingDestroy = content
    PopupClose.Visible = false
    tween(Popup, 0.12, { GroupTransparency = 1 })
    task.delay(0.13, function()
        if token == popupToken then
            PopupLayer.Visible = false
            if content then content:Destroy() end
            if PendingDestroy == content then PendingDestroy = nil end
        end
    end)
end

connect(PopupClose.MouseButton1Click, function() UI:ClosePopup() end)

local function beginPopup(anchor, width, height)
    if PopupOpen then UI:ClosePopup() end
    if PendingDestroy then PendingDestroy:Destroy() PendingDestroy = nil end
    popupToken += 1
    ActiveBucket = UI.PopupThemeObjects
    PopupOpen = true
    PopupLayer.Visible = true
    PopupClose.Visible = true

    local s = PopupScale.Scale
    local screen = ScreenGui.AbsoluteSize
    height = math.min(height, (screen.Y - 20) / s)
    local wPx, hPx = width * s, height * s
    local ap, asz = anchor.AbsolutePosition, anchor.AbsoluteSize

    local x = ap.X + asz.X - wPx
    local y = ap.Y + asz.Y + 6
    local up = false
    if y + hPx > screen.Y - 8 then
        y = ap.Y - 6
        up = true
    end
    x = math.clamp(x, 8, math.max(8, screen.X - wPx - 8))
    if up then y = math.max(y, hPx + 8) else y = math.max(8, y) end

    Popup.AnchorPoint = Vector2.new(0, up and 1 or 0)
    Popup.Position = UDim2.fromOffset(x, y)
    Popup.Size = UDim2.fromOffset(width, 0)
    Popup.GroupTransparency = 1

    local Body = create("Frame", { Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1 }, Popup)
    PopupContent = Body

    tween(Popup, 0.24, { Size = UDim2.fromOffset(width, height), GroupTransparency = 0 }, Enum.EasingStyle.Quint)
    return Body, height
end

function UI:OpenPopup(anchor, options, multiple, current, callback, title)
    local items = normalizeItems(options)
    local selected, singleKey = {}, nil
    if multiple then
        for _, item in ipairs(items) do selected[item.Key] = containsValue(current, item.Key) end
    elseif current ~= nil then
        singleKey = tostring(current)
    end

    local function isSelected(item)
        if multiple then return selected[item.Key] == true end
        return singleKey == item.Key
    end
    local function selectedList()
        local r = {}
        for _, item in ipairs(items) do if selected[item.Key] then table.insert(r, item.Value) end end
        return r
    end

    local showSearch = #items > 7
    local topPad = 38 + (showSearch and 38 or 0)
    local footerH = multiple and 46 or 0
    local wantList = math.max(34, math.min(#items, 7) * 32)
    local width = math.max(anchor.AbsoluteSize.X / PopupScale.Scale, 232)

    local Body, height = beginPopup(anchor, width, topPad + wantList + 8 + footerH)
    local listH = math.max(40, height - topPad - 8 - footerH)

    local HeaderLabel = create("TextLabel", {
        Size = UDim2.new(1, -28, 0, 20), Position = UDim2.fromOffset(14, 10), BackgroundTransparency = 1,
        Text = tostring(title or "Select"), Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
    }, Body)
    themeObject(HeaderLabel, "TextColor3", "Text")

    local SearchBox
    if showSearch then
        SearchBox = create("TextBox", {
            Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 36), BorderSizePixel = 0,
            Text = "", PlaceholderText = "Search...", Font = Enum.Font.Gotham, TextSize = 11,
            ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
        }, Body)
        corner(SearchBox, 7)
        themeObject(SearchBox, "BackgroundColor3", "Panel")
        themeObject(SearchBox, "TextColor3", "Text")
        themeObject(SearchBox, "PlaceholderColor3", "TextMuted")
        create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, SearchBox)
    end

    local List = create("ScrollingFrame", {
        Size = UDim2.new(1, -16, 0, listH), Position = UDim2.fromOffset(8, topPad), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 2, AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y,
    }, Body)
    themeObject(List, "ScrollBarImageColor3", "Accent")
    create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, List)

    if #items == 0 then
        local Empty = create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Text = "Nothing to select",
            Font = Enum.Font.Gotham, TextSize = 11,
        }, List)
        themeObject(Empty, "TextColor3", "TextMuted")
    end

    local Count, AllBtn, Clear, Done
    if multiple then
        local Foot = create("Frame", { Size = UDim2.new(1, 0, 0, footerH), Position = UDim2.new(0, 0, 1, -footerH), BackgroundTransparency = 1 }, Body)
        Count = create("TextLabel", {
            Size = UDim2.fromOffset(64, footerH), Position = UDim2.fromOffset(14, 0), BackgroundTransparency = 1,
            Text = "0 selected", Font = Enum.Font.GothamMedium, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
        }, Foot)
        themeObject(Count, "TextColor3", "TextMuted")
        local function footButton(text, x, w, accent)
            local b = create("TextButton", {
                Size = UDim2.fromOffset(w, 28), Position = UDim2.new(1, x, 0.5, -14), BorderSizePixel = 0,
                Text = text, Font = accent and Enum.Font.GothamBold or Enum.Font.GothamMedium, TextSize = 10, AutoButtonColor = false,
            }, Foot)
            corner(b, 7)
            themeObject(b, "BackgroundColor3", accent and "Accent" or "ElementHover")
            themeObject(b, "TextColor3", accent and "Text" or "TextMuted")
            return b
        end
        AllBtn = footButton("All", -160, 38, false)
        Clear = footButton("Clear", -118, 46, false)
        Done = footButton("Done", -68, 56, true)
    end

    local objects = {}

    local function paint(o, hover)
        local sel = isSelected(o.Item)
        local col = o.Item.Color or UI.Theme.Accent
        o.Button.BackgroundColor3 = sel and col or UI.Theme.ElementHover
        tween(o.Button, 0.12, { BackgroundTransparency = sel and (hover and 0.7 or 0.86) or (hover and 0 or 1) })
        o.Label.TextColor3 = sel and tint(col) or UI.Theme.Text
        o.Bar.BackgroundColor3 = col
        tween(o.Bar, 0.15, { BackgroundTransparency = sel and 0 or 1 })
        o.Check.TextColor3 = tint(col)
        o.Check.Visible = sel
    end

    local function refresh()
        local query = SearchBox and string.lower(SearchBox.Text) or ""
        for _, o in ipairs(objects) do
            o.Button.Visible = query == "" or string.find(string.lower(o.Item.Name), query, 1, true) ~= nil
            paint(o, false)
        end
        if Count then
            local n = 0
            for _, v in pairs(selected) do if v then n += 1 end end
            Count.Text = n .. " selected"
        end
    end

    for index, item in ipairs(items) do
        local Option = create("TextButton", {
            Size = UDim2.new(1, -6, 0, 30), BackgroundTransparency = 1, BorderSizePixel = 0, Text = "",
            AutoButtonColor = false, LayoutOrder = index,
        }, List)
        corner(Option, 7)
        local Bar = create("Frame", { Size = UDim2.fromOffset(3, 14), Position = UDim2.new(0, 4, 0.5, -7), BackgroundTransparency = 1, BorderSizePixel = 0 }, Option)
        corner(Bar, 2)
        local Label = create("TextLabel", {
            Size = UDim2.new(1, -40, 1, 0), Position = UDim2.fromOffset(16, 0), BackgroundTransparency = 1, Text = item.Name,
            Font = Enum.Font.GothamMedium, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        }, Option)
        local Check = create("TextLabel", {
            Size = UDim2.fromOffset(16, 30), Position = UDim2.new(1, -22, 0, 0), BackgroundTransparency = 1,
            Text = "✓", Font = Enum.Font.GothamBold, TextSize = 12, Visible = false,
        }, Option)

        local o = { Button = Option, Item = item, Check = Check, Bar = Bar, Label = Label }
        objects[index] = o

        popupConnect(Option.MouseEnter, function() paint(o, true) end)
        popupConnect(Option.MouseLeave, function() paint(o, false) end)
        popupConnect(Option.MouseButton1Click, function()
            if multiple then
                selected[item.Key] = not selected[item.Key]
                refresh()
                callback(selectedList())
            else
                callback(item.Value)
                UI:ClosePopup()
            end
        end)
    end

    if SearchBox then popupConnect(SearchBox:GetPropertyChangedSignal("Text"), refresh) end
    if multiple then
        popupConnect(AllBtn.MouseButton1Click, function()
            for _, item in ipairs(items) do selected[item.Key] = true end
            refresh()
            callback(selectedList())
        end)
        popupConnect(Clear.MouseButton1Click, function()
            for _, item in ipairs(items) do selected[item.Key] = false end
            refresh()
            callback({})
        end)
        popupConnect(Done.MouseButton1Click, function() UI:ClosePopup() end)
    end
    popupConnect(UserInputService.InputBegan, function(input)
        if input.KeyCode == Enum.KeyCode.Escape then UI:ClosePopup() end
    end)

    refresh()
    ActiveBucket = nil
end

