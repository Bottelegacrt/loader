function UI:OpenColorPicker(anchor, current, callback, title)
    local h, s, v = current:ToHSV()
    local width, height = 236, 236
    local Body = beginPopup(anchor, width, height)

    local Title = create("TextLabel", {
        Size = UDim2.new(1, -28, 0, 20), Position = UDim2.fromOffset(14, 10), BackgroundTransparency = 1,
        Text = tostring(title or "Color"), Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
    }, Body)
    themeObject(Title, "TextColor3", "Text")

    local SV = create("Frame", { Size = UDim2.fromOffset(212, 120), Position = UDim2.fromOffset(12, 36), BorderSizePixel = 0 }, Body)
    corner(SV, 8)
    local White = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, SV)
    corner(White, 8)
    create("UIGradient", { Transparency = NumberSequence.new(0, 1) }, White)
    local Black = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, SV)
    corner(Black, 8)
    create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, Black)
    local SVCursor = create("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, SV)
    corner(SVCursor, 999)
    create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, SVCursor)
    local SVHit = create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6 }, SV)

    local HueBar = create("Frame", { Size = UDim2.fromOffset(212, 12), Position = UDim2.fromOffset(12, 166), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, Body)
    corner(HueBar, 6)
    create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)), ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
            ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)), ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
            ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)), ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
        }),
    }, HueBar)
    local HueKnob = create("Frame", { Size = UDim2.fromOffset(6, 18), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 5 }, HueBar)
    corner(HueKnob, 3)
    create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, HueKnob)
    local HueHit = create("TextButton", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0.5, -12), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6 }, HueBar)

    local Preview = create("Frame", { Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(12, 192), BorderSizePixel = 0 }, Body)
    corner(Preview, 8)
    stroke(Preview, "Border", 1)
    local HexBox = create("TextBox", {
        Size = UDim2.fromOffset(108, 30), Position = UDim2.fromOffset(50, 192), BorderSizePixel = 0, Text = "",
        Font = Enum.Font.GothamBold, TextSize = 11, ClearTextOnFocus = false,
    }, Body)
    corner(HexBox, 7)
    themeObject(HexBox, "BackgroundColor3", "Panel")
    themeObject(HexBox, "TextColor3", "Text")
    local Done = create("TextButton", {
        Size = UDim2.fromOffset(58, 30), Position = UDim2.fromOffset(166, 192), BorderSizePixel = 0,
        Text = "Done", Font = Enum.Font.GothamBold, TextSize = 11, AutoButtonColor = false,
    }, Body)
    corner(Done, 7)
    themeObject(Done, "BackgroundColor3", "Accent")
    themeObject(Done, "TextColor3", "Text")

    local function refresh(fire, skipHex)
        local color = Color3.fromHSV(h, s, v)
        SV.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        SVCursor.Position = UDim2.fromScale(s, 1 - v)
        HueKnob.Position = UDim2.fromScale(h, 0.5)
        Preview.BackgroundColor3 = color
        if not skipHex then HexBox.Text = toHex(color) end
        if fire then callback(color) end
    end

    local dragSV, dragHue = false, false
    local function svFrom(pos)
        local ap, asz = SV.AbsolutePosition, SV.AbsoluteSize
        s = math.clamp((pos.X - ap.X) / math.max(asz.X, 1), 0, 1)
        v = 1 - math.clamp((pos.Y - ap.Y) / math.max(asz.Y, 1), 0, 1)
        refresh(true)
    end
    local function hueFrom(pos)
        local ap, asz = HueBar.AbsolutePosition, HueBar.AbsoluteSize
        h = math.clamp((pos.X - ap.X) / math.max(asz.X, 1), 0, 1)
        refresh(true)
    end
    local function isPointer(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
    end
    local function isMove(input)
        return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
    end

    popupConnect(SVHit.InputBegan, function(input) if isPointer(input) then dragSV = true svFrom(input.Position) end end)
    popupConnect(HueHit.InputBegan, function(input) if isPointer(input) then dragHue = true hueFrom(input.Position) end end)
    popupConnect(UserInputService.InputChanged, function(input)
        if not isMove(input) then return end
        if dragSV then svFrom(input.Position) elseif dragHue then hueFrom(input.Position) end
    end)
    popupConnect(UserInputService.InputEnded, function(input)
        if isPointer(input) then dragSV, dragHue = false, false end
    end)
