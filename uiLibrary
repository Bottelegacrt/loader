local panelToken = 0
local function ensurePanelFits()
	local s = computeScale()
	local screen = ScreenGui.AbsoluteSize
	local ap, asz = Root.AbsolutePosition, Root.AbsoluteSize
	local cx = ap.X + asz.X / 2
	local left = cx - BASE_W * s / 2
	local right = left + (BASE_W + PANEL_GAP + PANEL_W) * s
	local shift = 0
	if right > screen.X - 12 then shift = (screen.X - 12) - right end
	if left + shift < 12 then shift = 12 - left end
	if math.abs(shift) > 0.5 then
		local p = Root.Position
		tween(Root, 0.4, { Position = UDim2.new(p.X.Scale, p.X.Offset + shift, p.Y.Scale, p.Y.Offset) }, Enum.EasingStyle.Quint)
	end
end

