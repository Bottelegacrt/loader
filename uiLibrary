	corner(Bar, 2)
	themeObject(Bar, "BackgroundColor3", "Accent")

	local Box, Glyph = createGlyph(Button, icon, Tab.Name, 26, UDim2.fromOffset(12, 7), 8, false)
	local glyphProp = Glyph:IsA("ImageLabel") and "ImageColor3" or "TextColor3"

	local Label = create("TextLabel", {
		Size = UDim2.new(1, -84, 1, 0), Position = UDim2.fromOffset(46, 0), BackgroundTransparency = 1, Text = Tab.Name,
