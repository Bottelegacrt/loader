Effects.Warp = {
	Count = function(d) return math.floor(d * 0.9) end,
	Make = function(p) p.o = fxFrame(false) end,
	Spawn = function(p, first)
		p.ang = rnd(0, 6.2832)
		p.r = first and rnd(4, 380) or rnd(4, 30)
		p.k = rnd(0.8, 1.8)
		p.o.Rotation = math.deg(p.ang)
	end,
	Paint = function(p)
		p.o.BackgroundColor3 = Color3.new(1, 1, 1):Lerp(UI.Theme.Accent2, 0.35)
	end,
	Update = function(p, dt)
		p.r += (50 + p.r * 1.1) * p.k * dt
