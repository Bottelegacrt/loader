local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local BASE = {
	Background = Color3.fromRGB(8, 8, 12),
	Panel = Color3.fromRGB(14, 15, 21),
	Element = Color3.fromRGB(20, 21, 30),
	ElementHover = Color3.fromRGB(28, 29, 41),
	Border = Color3.fromRGB(30, 32, 44),
	Text = Color3.fromRGB(238, 238, 246),
	Muted = Color3.fromRGB(140, 142, 160),
	Dark = Color3.fromRGB(78, 80, 98),
	Accent = Color3.fromRGB(115, 92, 255),
	Accent2 = Color3.fromRGB(165, 145, 255),
	Success = Color3.fromRGB(85, 215, 140),
	Danger = Color3.fromRGB(235, 70, 88),
	Warning = Color3.fromRGB(255, 190, 80),
}

local WIDTH, HEIGHT = 360, 226

local function create(className, props, parent)
	local o = Instance.new(className)
	for k, v in pairs(props or {}) do
		pcall(function() o[k] = v end)
	end
	if parent then o.Parent = parent end
	return o
end

local function tween(o, d, props, style, dir)
	if not o or not o.Parent then return end
	local t = TweenService:Create(o, TweenInfo.new(d, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function corner(parent, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return create("UIStroke", {
		Color = color, Thickness = thickness or 1, Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function tint(c)
	return c:Lerp(Color3.new(1, 1, 1), 0.4)
end

local function textWidth(text, size, font)
	local ok, r = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(1000, 100))
	end)
	return ok and math.ceil(r.X) or math.ceil(#text * size * 0.58)
end

local HubLoader = {}
HubLoader.__index = HubLoader

function HubLoader.new(config)
	config = config or {}

	local old = _G.__LoyaltyHub
	if type(old) == "table" and type(old.Destroy) == "function" then
		pcall(function() old:Destroy(true) end)
	end
	local stale = PlayerGui:FindFirstChild("LoyaltyHub")
	if stale then stale:Destroy() end

	local C = {}
	for k, v in pairs(BASE) do C[k] = v end
	if typeof(config.Accent) == "Color3" then
		C.Accent = config.Accent
		C.Accent2 = config.Accent:Lerp(Color3.new(1, 1, 1), 0.35)
	end

	local self = setmetatable({
		Config = config, Colors = C, Connections = {}, Busy = false, Alive = true, Loaded = false,
		Failed = false, Progress = 0, StepText = "Loading", UI = {},
	}, HubLoader)

	local function connect(signal, fn)
		local c = signal:Connect(fn)
		table.insert(self.Connections, c)
		return c
	end

	local games = config.Games
	local entry = games and (games[game.PlaceId] or games[game.GameId] or games[tostring(game.PlaceId)]) or nil
	if entry == true then entry = {} end
	self.Entry = entry
	self.Mode = games == nil and "test" or (entry and "supported" or "unsupported")
	self.Loader = (entry and entry.Loader) or config.Loader
	self.AccentSeq = ColorSequence.new(C.Accent, C.Accent2)

	local Gui = create("ScreenGui", {
		Name = "LoyaltyHub", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 200,
	}, PlayerGui)
	self.Gui = Gui

	local Root = create("CanvasGroup", {
		Name = "Root", Size = UDim2.fromOffset(WIDTH, HEIGHT), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 26), BackgroundColor3 = C.Background, BorderSizePixel = 0,
		GroupTransparency = 1, Active = true,
	}, Gui)
	corner(Root, 16)
	local RootScale = create("UIScale", { Scale = 0.92 }, Root)
	self.UI.Root, self.UI.RootScale = Root, RootScale

	local Glow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = C.Accent, BorderSizePixel = 0,
	}, Root)
	create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 1) }),
	}, Glow)

	local Border = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 50 }, Root)
	corner(Border, 16)
	local BorderStroke = create("UIStroke", {
		Thickness = 1, Color = Color3.new(1, 1, 1), ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, Border)
	local BorderGradient = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C.Accent), ColorSequenceKeypoint.new(0.3, C.Border),
			ColorSequenceKeypoint.new(0.7, C.Border), ColorSequenceKeypoint.new(1, C.Accent),
		}),
	}, BorderStroke)

	local Dot = create("Frame", { Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(18, 17), BackgroundColor3 = C.Accent, BorderSizePixel = 0 }, Root)
	corner(Dot, 4)
	create("UIStroke", { Color = C.Accent, Thickness = 3, Transparency = 0.78, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Dot)

	local title = string.upper(tostring(config.Title or "Loyalty Hub"))
	local titleW = textWidth(title, 11, Enum.Font.GothamBold) + 4
	create("TextLabel", {
		Size = UDim2.fromOffset(titleW, 26), Position = UDim2.fromOffset(34, 8), BackgroundTransparency = 1, Text = title,
		Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left,
	}, Root)
	create("TextLabel", {
		Size = UDim2.fromOffset(60, 26), Position = UDim2.fromOffset(34 + titleW + 6, 8), BackgroundTransparency = 1,
		Text = tostring(config.Version or "v1.0"), Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = C.Dark,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Root)
	create("TextLabel", {
		Size = UDim2.new(1, -(34 + titleW + 6 + 60 + 50), 0, 26), Position = UDim2.new(1, -46, 0, 8), AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1, Text = LocalPlayer.DisplayName, Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
	}, Root)

	local Close = create("TextButton", {
		Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -38, 0, 8), BackgroundColor3 = C.Element, BackgroundTransparency = 1,
		BorderSizePixel = 0, Text = "×", Font = Enum.Font.GothamMedium, TextSize = 18, TextColor3 = C.Muted, AutoButtonColor = false,
	}, Root)
	corner(Close, 8)
	connect(Close.MouseEnter, function()
		tween(Close, 0.15, { BackgroundTransparency = 0, BackgroundColor3 = C.Danger, TextColor3 = C.Text })
	end)
	connect(Close.MouseLeave, function()
		tween(Close, 0.15, { BackgroundTransparency = 1, TextColor3 = C.Muted })
	end)
	connect(Close.MouseButton1Click, function() self:Destroy() end)

	local Line = create("Frame", {
		Size = UDim2.new(1, -36, 0, 1), Position = UDim2.fromOffset(18, 40), BackgroundColor3 = C.Border, BackgroundTransparency = 0.4, BorderSizePixel = 0,
	}, Root)

	local Thumb = create("CanvasGroup", {
		Size = UDim2.fromOffset(84, 84), Position = UDim2.fromOffset(18, 54), BackgroundColor3 = C.Panel, BorderSizePixel = 0,
	}, Root)
	corner(Thumb, 14)
	stroke(Thumb, C.Accent, 1, 0.5)
	local ThumbLetter = create("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "?", Font = Enum.Font.GothamBold, TextSize = 32, TextColor3 = C.Accent,
	}, Thumb)
	local ThumbImage = create("ImageLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ImageTransparency = 1,
		Image = "rbxthumb://type=GameIcon&id=" .. tostring(game.GameId) .. "&w=150&h=150", ScaleType = Enum.ScaleType.Crop,
	}, Thumb)
	local Shine = create("Frame", {
		Size = UDim2.new(0, 26, 1.8, 0), Position = UDim2.new(-0.6, 0, -0.4, 0), Rotation = 20,
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.9, BorderSizePixel = 0,
	}, Thumb)
	create("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }),
	}, Shine)

	local NameLabel = create("TextLabel", {
		Size = UDim2.new(1, -134, 0, 42), Position = UDim2.fromOffset(116, 54), BackgroundTransparency = 1,
		Text = "Loading...", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = C.Text, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd,
	}, Root)

	local pill = {
		test = { "TEST MODE", C.Warning },
		supported = { "SUPPORTED", C.Success },
		unsupported = { "UNSUPPORTED", C.Danger },
	}
	local pillText, pillColor = pill[self.Mode][1], pill[self.Mode][2]
	local Pill = create("Frame", {
		Size = UDim2.fromOffset(textWidth(pillText, 9, Enum.Font.GothamBold) + 32, 22), Position = UDim2.fromOffset(116, 116),
		BackgroundColor3 = pillColor, BackgroundTransparency = 0.84, BorderSizePixel = 0,
	}, Root)
	corner(Pill, 11)
	stroke(Pill, pillColor, 1, 0.2)
	local PillDot = create("Frame", { Size = UDim2.fromOffset(6, 6), Position = UDim2.fromOffset(10, 8), BackgroundColor3 = pillColor, BorderSizePixel = 0 }, Pill)
	corner(PillDot, 3)
	create("TextLabel", {
		Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(22, 0), BackgroundTransparency = 1, Text = pillText,
		Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = tint(pillColor), TextXAlignment = Enum.TextXAlignment.Left,
	}, Pill)

	local function makeChip(x, label, value, sample)
		local lw = textWidth(label, 9, Enum.Font.GothamBold)
		local vw = textWidth(sample or value, 11, Enum.Font.GothamBold)
		local width = 10 + lw + 8 + vw + 10
		local F = create("TextButton", {
			Size = UDim2.fromOffset(width, 26), Position = UDim2.fromOffset(x, 150), BackgroundColor3 = C.Element,
			BorderSizePixel = 0, Text = "", AutoButtonColor = false,
		}, Root)
		corner(F, 8)
		local S = stroke(F, C.Border, 1)
		create("TextLabel", {
			Size = UDim2.fromOffset(lw, 26), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = label,
			Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = C.Dark, TextXAlignment = Enum.TextXAlignment.Left,
		}, F)
		local V = create("TextLabel", {
			Size = UDim2.fromOffset(vw, 26), Position = UDim2.fromOffset(10 + lw + 8, 0), BackgroundTransparency = 1, Text = value,
			Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left,
		}, F)
		connect(F.MouseEnter, function()
			tween(F, 0.15, { BackgroundColor3 = C.ElementHover })
			tween(S, 0.15, { Color = C.Dark })
		end)
		connect(F.MouseLeave, function()
			tween(F, 0.15, { BackgroundColor3 = C.Element })
			tween(S, 0.15, { Color = C.Border })
		end)
		return F, V, width
	end

	local placeText = game.PlaceId == 0 and "Studio" or tostring(game.PlaceId)
	local PlaceChip, PlaceValue, placeWidth = makeChip(18, "PLACE", placeText)
	local _, PlayersValue = makeChip(18 + placeWidth + 8, "PLAYERS", "0/0", "00/00")

	local copyToken = 0
	connect(PlaceChip.MouseButton1Click, function()
		local clip = setclipboard or toclipboard
		if type(clip) ~= "function" or game.PlaceId == 0 then return end
		pcall(clip, tostring(game.PlaceId))
		copyToken += 1
		local my = copyToken
		PlaceValue.Text = "Copied"
		PlaceValue.TextColor3 = C.Success
		task.delay(1.2, function()
			if my == copyToken and self.Alive then
				PlaceValue.Text = placeText
				PlaceValue.TextColor3 = C.Text
			end
		end)
	end)

	local Status = create("TextLabel", {
		Size = UDim2.new(1, -100, 0, 16), Position = UDim2.fromOffset(18, 186), BackgroundTransparency = 1, Text = "",
		Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, Root)
	local Percent = create("TextLabel", {
		Size = UDim2.fromOffset(60, 16), Position = UDim2.new(1, -78, 0, 186), BackgroundTransparency = 1, Text = "0%",
		Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = C.Accent2, TextXAlignment = Enum.TextXAlignment.Right,
	}, Root)

	local Track = create("CanvasGroup", {
		Size = UDim2.new(1, -36, 0, 6), Position = UDim2.fromOffset(18, 208), BackgroundColor3 = C.Element, BorderSizePixel = 0,
	}, Root)
	corner(Track, 3)
	local Fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, Track)
	corner(Fill, 3)
	local FillGradient = create("UIGradient", { Color = self.AccentSeq }, Fill)
	local Shimmer = create("Frame", {
		Size = UDim2.new(0, 46, 1, 0), Position = UDim2.new(-0.3, 0, 0, 0), BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.7, BorderSizePixel = 0, Visible = false,
	}, Track)
	create("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }),
	}, Shimmer)

	local Retry = create("TextButton", {
		Size = UDim2.new(1, -36, 0, 34), Position = UDim2.fromOffset(18, 182), BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, Visible = false, ZIndex = 10,
	}, Root)
	connect(Retry.MouseButton1Click, function() self:Load() end)

	self.UI.Fill, self.UI.FillGradient, self.UI.Status, self.UI.Percent, self.UI.Shimmer, self.UI.Retry =
		Fill, FillGradient, Status, Percent, Shimmer, Retry

	local blocked = self.Mode == "unsupported" and not config.AllowUnsupported
	self.Blocked = blocked
	if blocked then
		Status.Text = "Unsupported game"
		Status.TextColor3 = C.Danger
		Percent.Text = ""
		FillGradient.Color = ColorSequence.new(C.Danger, C.Danger)
	else
		Status.Text = "Preparing"
	end

	local function setName(name)
		if not self.Alive then return end
		NameLabel.Text = name
		ThumbLetter.Text = string.upper(string.sub(name, 1, 1))
		NameLabel.TextTransparency = 1
		tween(NameLabel, 0.35, { TextTransparency = 0 })
	end

	task.spawn(function()
		local name = entry and entry.Name or nil
		if not name and game.PlaceId ~= 0 then
			local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
			if ok and type(info) == "table" and info.Name then name = info.Name end
		end
		setName(name or (game.PlaceId == 0 and "Local Place" or game.Name))
	end)

	task.delay(0.25, function()
		if self.Alive then tween(ThumbImage, 0.5, { ImageTransparency = 0 }) end
	end)

	task.spawn(function()
		while self.Alive do
			PlayersValue.Text = string.format("%d/%d", #Players:GetPlayers(), Players.MaxPlayers)
			task.wait(2)
		end
	end)

	local clock = 0
	connect(RunService.Heartbeat, function(dt)
		clock += dt
		BorderGradient.Rotation = (BorderGradient.Rotation + dt * 45) % 360
		Shine.Position = UDim2.new(-0.6 + ((clock % 3.4) / 3.4) * 2.2, 0, -0.4, 0)
		if self.Busy then
			Shimmer.Position = UDim2.new(-0.3 + ((clock % 1.4) / 1.4) * 1.6, 0, 0, 0)
			Status.Text = self.StepText .. string.rep(".", math.floor(clock * 3) % 4)
		end
	end)

	local dragging, dragStart, dragOrigin = false, nil, nil
	connect(Root.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		dragging, dragStart, dragOrigin = true, input.Position, Root.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end)
	connect(UserInputService.InputChanged, function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local d = input.Position - dragStart
		Root.Position = UDim2.new(dragOrigin.X.Scale, dragOrigin.X.Offset + d.X, dragOrigin.Y.Scale, dragOrigin.Y.Offset + d.Y)
	end)
	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)

	tween(Root, 0.55, { Position = UDim2.new(0.5, 0, 0.5, 0), GroupTransparency = 0 })
	tween(RootScale, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)

	_G.__LoyaltyHub = self

	if not blocked and config.AutoStart ~= false then
		task.delay(config.StartDelay or 0.8, function()
			if self.Alive then self:Load() end
		end)
	end

	return self
end

function HubLoader:SetProgress(p, text)
	if not self.Alive then return end
	p = math.clamp(tonumber(p) or 0, 0, 1)
	self.Progress = p
	local ui = self.UI
	tween(ui.Fill, 0.3, { Size = UDim2.fromScale(p, 1) })
	ui.Percent.Text = string.format("%d%%", math.floor(p * 100 + 0.5))
	if text then self.StepText = tostring(text) end
end

-- НОВЫЙ МЕТОД: Отображение состояния обновления (Желтая полоса)
function HubLoader:SetUpdatingState(message)
	if not self.Alive then return end
	local ui, C = self.UI, self.Colors
	self.Busy = false
	ui.Shimmer.Visible = false
	ui.FillGradient.Color = ColorSequence.new(C.Warning, C.Warning)
	ui.Status.TextColor3 = C.Warning
	ui.Percent.TextColor3 = C.Warning
	ui.Status.Text = tostring(message or "Updating...")
	ui.Percent.Text = "WAIT"
	self:SetProgress(1)
	ui.Retry.Visible = true
end

function HubLoader:Load()
	if self.Busy or self.Loaded or not self.Alive or self.Blocked then return end
	self.Busy = true
	self.Failed = false

	local ui, C = self.UI, self.Colors
	ui.Retry.Visible = false
	ui.Fill.Size = UDim2.fromScale(0, 1)
	ui.FillGradient.Color = self.AccentSeq
	ui.Status.TextColor3 = C.Text
	ui.Percent.TextColor3 = C.Accent2
	ui.Shimmer.Visible = true
	self:SetProgress(0, "Loading")

	task.spawn(function()
		local ok, err = pcall(function()
			if self.Loader then
				self.Loader(function(p, t) self:SetProgress(p, t) end, self)
			else
				local steps = { "Checking game", "Fetching modules", "Building interface", "Finalizing" }
				for i, s in ipairs(steps) do
					self:SetProgress((i - 1) / #steps, s)
					task.wait(0.35 + math.random() * 0.35)
				end
			end
		end)
		if not self.Alive then return end

		-- Если был вызван SetUpdatingState, не перебиваем его красной ошибкой
		if ui.Percent.Text == "WAIT" then return end

		self.Busy = false
		ui.Shimmer.Visible = false
		if ok then
			self.Loaded = true
			ui.FillGradient.Color = ColorSequence.new(C.Success, C.Success:Lerp(Color3.new(1, 1, 1), 0.25))
			ui.Status.TextColor3 = C.Success
			ui.Percent.TextColor3 = C.Success
			ui.Status.Text = "Loaded"
			self:SetProgress(1)
			if self.Config.OnLoaded then task.spawn(self.Config.OnLoaded, self) end
			if self.Config.AutoClose ~= false then
				task.wait(1.1)
				self:Destroy()
			end
		else
			-- Очищаем технический префикс ошибки Roblox (например, "Script:12: ...")
			local cleanErr = tostring(err):gsub("^.+:%d+:%s*", "")
			warn("[HubLoader] " .. cleanErr)
			self.Failed = true
			ui.FillGradient.Color = ColorSequence.new(C.Danger, C.Danger:Lerp(Color3.new(1, 1, 1), 0.2))
			ui.Status.TextColor3 = C.Danger
			ui.Percent.TextColor3 = C.Danger
			ui.Status.Text = cleanErr ~= "" and cleanErr or "Failed - click to retry"
			self:SetProgress(1)
			ui.Retry.Visible = true
		end
	end)
end

function HubLoader:Destroy(instant)
	if not self.Alive then return end
	self.Alive = false
	for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
	self.Connections = {}
	if _G.__LoyaltyHub == self then _G.__LoyaltyHub = nil end
	local gui = self.Gui
	if instant then
		gui:Destroy()
		return
	end
	tween(self.UI.Root, 0.35, { GroupTransparency = 1, Position = self.UI.Root.Position + UDim2.fromOffset(0, 18) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	tween(self.UI.RootScale, 0.35, { Scale = 0.94 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	task.delay(0.4, function() gui:Destroy() end)
end

return HubLoader
